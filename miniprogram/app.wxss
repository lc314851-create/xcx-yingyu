/* app.wxss - 全局样式 ·「英语补词达人」设计系统
   人格：米纸底 + 松绿墨 + 朱砂印 + 荧光笔 + 和纸胶带（手账风） */

/* ═════════════════════════════════════════ */
/* 设计 Token 变量系统                         */
/* ═════════════════════════════════════════ */
page {
  /* 主色调：松绿墨 */
  --color-primary: #2F5746;
  --color-primary-light: #5F8F7A;
  --color-primary-dark: #24473A;
  --color-primary-bg: #E9F0EB;
  --color-primary-bg-light: #F3F7F1;

  /* 强调色：朱砂印 */
  --color-accent: #B84A3E;
  --color-accent-bg: #F6E8E4;

  /* 荧光笔黄 */
  --color-highlight: #F2C94C;
  --color-highlight-soft: #FAEDCB;

  /* 功能色 */
  --color-success: #3E8E5E;
  --color-success-bg: #E5F1E9;
  --color-warning: #C98F2C;
  --color-warning-bg: #F9F1DE;
  --color-danger: #B84A3E;
  --color-danger-bg: #F6E8E4;
  --color-info: #2F5746;
  --color-info-bg: #E9F0EB;

  /* 文字色：墨 */
  --text-primary: #2B2620;
  --text-secondary: #6E6656;
  --text-tertiary: #9A9078;
  --text-quaternary: #C6BCA4;
  --text-on-primary: #F9F6EE;

  /* 背景色：纸 */
  --bg-page: #F7F3EA;
  --bg-card: #FFFDF6;
  --bg-elevated: #FFFDF6;
  --bg-muted: #EFE9DA;
  --bg-hover: #FBF7EC;

  /* 边框 */
  --border-light: #EBE4D3;
  --border-default: #E0D7C2;
  --border-strong: #C9BEA2;
  --border-ink: #2B2620;

  /* 圆角：纸品small radius */
  --radius-sm: 6rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-pill: 999rpx;
  --radius-circle: 50%;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 40rpx;
  --space-2xl: 60rpx;

  /* 阴影：暖纸阴影 */
  --shadow-sm: 0 2rpx 6rpx rgba(88, 70, 42, 0.06);
  --shadow-md: 0 4rpx 14rpx rgba(88, 70, 42, 0.08);
  --shadow-lg: 0 8rpx 28rpx rgba(88, 70, 42, 0.14);
  --shadow-primary: 0 6rpx 18rpx rgba(47, 87, 70, 0.18);
  --shadow-primary-strong: 0 6rpx 20rpx rgba(47, 87, 70, 0.35);

  /* 字号 */
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-base: 28rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;
  --font-2xl: 48rpx;
  --font-3xl: 56rpx;
  --font-4xl: 72rpx;

  /* 动画 */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --duration-fast: 0.15s;
  --duration-normal: 0.25s;
  --duration-slow: 0.4s;

  /* 应用基础样式 */
  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: var(--font-base);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
}

/* ═════════════════════════════════════════ */
/* 手账风通用元素                                */
/* ═════════════════════════════════════════ */

/* 衬线字：英文单词、数字、标题装饰 */
.serif {
  font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
}

/* 通用卡片：纸卡 */
.card {
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin: var(--space-md) var(--space-md);
  box-shadow: var(--shadow-md);
}

/* 纸卡 + 和纸胶带（卡片顶部一条斜贴胶带）*/
.card-taped {
  position: relative;
  overflow: visible;
}

.card-taped::before {
  content: "";
  position: absolute;
  top: -18rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-2deg);
  width: 130rpx;
  height: 34rpx;
  background: rgba(242, 201, 76, 0.55);
  border-left: 2rpx dashed rgba(255, 255, 255, 0.7);
  border-right: 2rpx dashed rgba(255, 255, 255, 0.7);
  box-shadow: 0 2rpx 4rpx rgba(88, 70, 42, 0.10);
}

/* 横线便签底（index card 风格） */
.lined-paper {
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 62rpx,
    rgba(47, 87, 70, 0.10) 62rpx,
    rgba(47, 87, 70, 0.10) 64rpx
  );
  background-position: 0 14rpx;
}

/* 虚线分隔线（手账剪贴线） */
.dashed-divider {
  border-top: 2rpx dashed var(--border-strong);
}

/* 印章角标（红色“印”） */
.stamp {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 14rpx;
  border: 3rpx solid var(--color-accent);
  border-radius: 8rpx;
  color: var(--color-accent);
  font-size: var(--font-xs);
  font-weight: 700;
  letter-spacing: 2rpx;
  transform: rotate(-3deg);
  background: var(--color-accent-bg);
}

/* 荧光笔标注文字 */
.marker-text {
  background: linear-gradient(180deg, transparent 55%, var(--color-highlight-soft) 55%, var(--color-highlight-soft) 92%, transparent 92%);
  padding: 0 6rpx;
}

/* ═════════════════════════════════════════ */
/* 通用组件                                    */
/* ═════════════════════════════════════════ */

/* 主按钮：松绿墨 */
.btn-primary {
  background: var(--color-primary);
  color: var(--text-on-primary);
  border-radius: var(--radius-pill);
  font-size: var(--font-md);
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: var(--shadow-primary);
  transition: transform var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}

.btn-primary:active {
  transform: scale(0.97) translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(47, 87, 70, 0.25);
}

/* 副按钮：纸面墨边 */
.btn-secondary {
  background: var(--bg-card);
  color: var(--color-primary);
  border: 2rpx solid var(--border-strong);
  border-radius: var(--radius-pill);
  font-size: var(--font-base);
  font-weight: 600;
  padding: 18rpx 0;
  text-align: center;
  transition: transform var(--duration-fast) var(--ease-out),
              background var(--duration-fast) var(--ease-out);
}

.btn-secondary:active {
  transform: scale(0.97) translateY(2rpx);
  background: var(--bg-muted);
}

/* 标题 */
.page-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  padding: var(--space-xl) var(--space-lg) var(--space-sm);
}

/* 通用安全区域底部 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
