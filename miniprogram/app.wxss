/* app.wxss - 全局样式 */
page {
  background-color: #F6F8FC;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #2B2F36;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: #4A90D9;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 副按钮 */
.btn-secondary {
  background: #EEF3FB;
  color: #4A90D9;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
  text-align: center;
}

/* 标题 */
.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2430;
  padding: 30rpx 30rpx 10rpx;
}