<!-- pages/scene/scene.wxml -->
<view class="page">

  <!-- ═══════ 场景列表 ═══════ -->
  <block wx:if="{{stage === 'list'}}">
    <view class="page-head">
      <view class="page-head-title serif">情景剧本</view>
      <view class="page-head-sub">把单词放进生活里，读一段剧本，演一场英文</view>
    </view>

    <view class="scene-grid">
      <view
        class="scene-card card-taped"
        wx:for="{{sceneList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openScene"
      >
        <view class="scene-etag serif">{{item.enTitle}}</view>
        <view class="scene-title">{{item.title}}</view>
        <view class="scene-subtitle">{{item.subtitle}}</view>
        <view class="scene-meta">
          <text class="scene-meta-item">{{item.levelLabel}}</text>
          <text class="scene-meta-dot">·</text>
          <text class="scene-meta-item">{{item.lineCount}} 幕台词</text>
          <text class="scene-meta-dot">·</text>
          <text class="scene-meta-item">{{item.wordCount}} 个关键词</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ═══════ 读剧本 ═══════ -->
  <block wx:if="{{stage === 'read' && scene}}">
    <view class="read-head">
      <view class="read-back" bindtap="backToList">‹ 返回</view>
      <view class="read-title serif">{{scene.enTitle}}</view>
      <view class="read-setting">{{scene.setting}}</view>
    </view>

    <view class="dialogue">
      <view
        class="line {{item.speaker === 'A' ? 'line-a' : 'line-b'}}"
        wx:for="{{scene.dialogue}}"
        wx:key="index"
        data-en="{{item.en}}"
        bindtap="onPlayLine"
      >
        <view class="line-avatar serif">{{item.speaker}}</view>
        <view class="line-bubble">
          <view class="line-en serif">{{item.en}}</view>
          <view class="line-zh">{{item.zh}}</view>
        </view>
      </view>
    </view>

    <view class="keyword-panel">
      <view class="keyword-panel-title">本幕关键词 · 点一点查词典</view>
      <view class="keyword-chips">
        <view
          class="keyword-chip {{activeWordIdx === index ? 'active' : ''}}"
          wx:for="{{scene.keyWords}}"
          wx:key="word"
          data-idx="{{index}}"
          bindtap="onWordTap"
        >{{item.word}}</view>
      </view>
    </view>

    <view class="btn-primary quiz-btn" bindtap="startQuiz">开始场景演练</view>

    <!-- 单词弹窗 -->
    <view class="word-mask" wx:if="{{wordPopup}}" bindtap="closeWordPopup"></view>
    <view class="word-popup card-taped" wx:if="{{wordPopup}}">
      <view class="word-popup-head">
        <view class="word-popup-word serif">{{wordPopup.word}}</view>
        <view class="word-popup-phonetic">{{wordPopup.phonetic}}</view>
      </view>
      <view class="word-popup-meaning">{{wordPopup.meaning}}</view>
      <view class="word-popup-ctx">「{{wordPopup.context}}」</view>
    </view>
  </block>

  <!-- ═══════ 场景演练 ═══════ -->
  <block wx:if="{{stage === 'quiz'}}">
    <view class="quiz-top">
      <view class="quiz-back" bindtap="backToRead">‹ 读剧</view>
      <view class="quiz-progress">{{currentQ + 1}} / {{quiz.length}}</view>
    </view>

    <view class="quiz-prompt">这一幕里它是什么意思？</view>
    <view class="quiz-word serif">{{quiz[currentQ].word}}</view>
    <view class="quiz-phonetic">{{quiz[currentQ].phonetic}}</view>

    <view class="quiz-options">
      <view
        class="quiz-option {{answered && index === quiz[currentQ].correctIndex ? 'correct' : ''}} {{answered && selected === index && !isCorrect ? 'wrong' : ''}}"
        wx:for="{{quiz[currentQ].options}}"
        wx:key="index"
        data-idx="{{index}}"
        bindtap="onSelectOption"
      >
        <view class="quiz-option-letter serif">{{['A','B','C','D'][index]}}</view>
        <view class="quiz-option-text">{{item}}</view>
      </view>
    </view>
  </block>

  <!-- ═══════ 结算 ═══════ -->
  <block wx:if="{{stage === 'result'}}">
    <view class="result-card card-taped">
      <view class="result-stamp">{{levelLabel}}</view>
      <view class="result-score serif">{{correctCount}}<text class="result-score-total">/ {{quiz.length}}</text></view>
      <view class="result-desc" wx:if="{{wrongWords.length === 0}}">全对！这一幕的词汇已经住手了。</view>
      <view class="result-desc" wx:else>答错的 {{wrongWords.length}} 个词已收入生词本，改天再来演练一遍吧。</view>
      <view class="result-words" wx:if="{{wrongWords.length}}">
        <view class="result-word-row" wx:for="{{wrongWords}}" wx:key="word">
          <text class="result-word serif">{{item.word}}</text>
          <text class="result-meaning">{{item.meaning}}</text>
        </view>
      </view>
    </view>
    <view class="btn-primary result-btn" bindtap="restartQuiz">再演练一遍</view>
    <view class="btn-secondary result-btn" bindtap="backToList">回到剧本列表</view>
  </block>
</view>
