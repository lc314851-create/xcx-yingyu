/* pages/scene/scene.wxss - 情景剧本·剧场手账 */

.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.page-head {
  padding: 40rpx 40rpx 20rpx;
}

.page-head-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 4rpx;
}

.page-head-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* ─── 场景列表：剧目卡片 ─── */
.scene-grid {
  padding: 10rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.scene-card {
  position: relative;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 16rpx;
  padding: 40rpx 36rpx 30rpx;
  box-shadow: var(--shadow-md);
  transition: transform 0.15s var(--ease-out);
  margin-top: 10rpx;
}

.scene-card:active {
  transform: scale(0.98);
}

.scene-etag {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 3rpx;
  margin-bottom: 6rpx;
}

.scene-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.scene-subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.scene-meta {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.scene-meta-item {
  padding-right: 6rpx;
}

.scene-meta-dot {
  color: var(--text-quaternary);
  padding: 0 6rpx;
}

/* ─── 读剧本 ─── */
.read-head {
  padding: 30rpx 40rpx 10rpx;
}

.read-back {
  font-size: 26rpx;
  color: var(--color-primary);
  display: inline-block;
  padding: 8rpx 0;
}

.read-title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

.read-setting {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--color-highlight);
}

.dialogue {
  padding: 28rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.line {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.line-a {
  flex-direction: row-reverse;
}

.line-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--bg-muted);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
  border: 2rpx solid var(--border-default);
}

.line-a .line-avatar {
  background: var(--color-primary);
  color: var(--text-on-primary);
  border-color: var(--color-primary);
}

.line-bubble {
  max-width: 78%;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 4rpx 18rpx 18rpx 18rpx;
  padding: 18rpx 22rpx;
  box-shadow: var(--shadow-sm);
}

.line-a .line-bubble {
  background: var(--color-primary-bg);
  border-color: var(--color-primary-light);
  border-radius: 18rpx 4rpx 18rpx 18rpx;
}

.line-en {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.line-zh {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ─── 关键词面板 ─── */
.keyword-panel {
  margin: 8rpx 30rpx;
  padding: 26rpx 28rpx;
  background: var(--color-primary-bg-light);
  border: 2rpx dashed var(--border-strong);
  border-radius: 16rpx;
}

.keyword-panel-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

.keyword-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.keyword-chip {
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  font-family: Georgia, 'Times New Roman', serif;
  color: var(--color-primary-dark);
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 999rpx;
  transition: all 0.15s var(--ease-out);
}

.keyword-chip.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--text-on-primary);
}

.quiz-btn {
  margin: 36rpx 40rpx 0;
}

/* ─── 单词弹窗 ─── */
.word-mask {
  position: fixed;
  inset: 0;
  background: rgba(43, 38, 32, 0.35);
  z-index: 20;
}

.word-popup {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 32%;
  z-index: 21;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 20rpx;
  padding: 48rpx 40rpx 36rpx;
  box-shadow: var(--shadow-lg);
  animation: popIn 0.25s var(--ease-spring);
}

@keyframes popIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.word-popup-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.word-popup-word {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.word-popup-phonetic {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.word-popup-meaning {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: var(--color-primary-dark);
  font-weight: 600;
}

.word-popup-ctx {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--border-default);
  font-size: 26rpx;
  color: var(--text-secondary);
  font-style: italic;
}

/* ─── 演练 ─── */
.quiz-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
}

.quiz-back {
  font-size: 26rpx;
  color: var(--color-primary);
}

.quiz-progress {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
}

.quiz-prompt {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 40rpx;
}

.quiz-word {
  text-align: center;
  font-size: 60rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 16rpx;
}

.quiz-phonetic {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.quiz-options {
  padding: 44rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.quiz-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 14rpx;
  transition: all 0.2s var(--ease-out);
}

.quiz-option-letter {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-muted);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.quiz-option.correct {
  background: var(--color-success-bg);
  border-color: var(--color-success);
}

.quiz-option.correct .quiz-option-letter {
  background: var(--color-success);
  color: #fff;
}

.quiz-option.wrong {
  background: var(--color-danger-bg);
  border-color: var(--color-danger);
}

.quiz-option.wrong .quiz-option-letter {
  background: var(--color-danger);
  color: #fff;
}

.quiz-option-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

/* ─── 结算 ─── */
.result-card {
  position: relative;
  margin: 60rpx 40rpx 0;
  padding: 70rpx 40rpx 44rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 20rpx;
  text-align: center;
  box-shadow: var(--shadow-lg);
}

.result-stamp {
  display: inline-block;
  padding: 8rpx 28rpx;
  border: 4rpx solid var(--color-accent);
  border-radius: 10rpx;
  color: var(--color-accent);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  transform: rotate(-4deg);
  background: var(--color-accent-bg);
}

.result-score {
  font-size: 88rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 26rpx;
  font-variant-numeric: tabular-nums;
}

.result-score-total {
  font-size: 40rpx;
  color: var(--text-tertiary);
}

.result-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.result-words {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--border-default);
  text-align: left;
}

.result-word-row {
  display: flex;
  gap: 18rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.result-word {
  color: var(--color-primary-dark);
  font-weight: 700;
  min-width: 180rpx;
}

.result-meaning {
  color: var(--text-secondary);
}

.result-btn {
  margin: 30rpx 40rpx 0;
}
