/* pages/story/story.wxss - 双语阅读·书页手账 */

.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.page-head {
  padding: 40rpx 40rpx 20rpx;
}

.page-head-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 4rpx;
}

.page-head-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* ─── 故事卡片 ─── */
.story-grid {
  padding: 10rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.story-card {
  position: relative;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 16rpx;
  padding: 30rpx 36rpx;
  box-shadow: var(--shadow-md);
  transition: transform 0.15s var(--ease-out);
  margin-top: 10rpx;
}

.story-card:active {
  transform: scale(0.98);
}

.story-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.story-level {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

.story-level.medium {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}

.story-level.hard {
  background: var(--color-accent-bg);
  color: var(--color-accent);
}

.story-finished {
  font-size: 22rpx;
  color: var(--color-success);
}

.story-etag {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 3rpx;
  margin-top: 6rpx;
}

.story-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 4rpx;
  letter-spacing: 2rpx;
}

.story-intro {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.story-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.story-meta-dot {
  color: var(--text-quaternary);
  padding: 0 6rpx;
}

/* ─── 阅读器头部 ─── */
.reader-head {
  padding: 24rpx 36rpx 6rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.reader-back {
  font-size: 28rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

.reader-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 工具栏 */
.reader-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 36rpx;
}

.mode-chips {
  display: flex;
  gap: 10rpx;
}

.mode-chip {
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 999rpx;
  transition: all 0.15s var(--ease-out);
}

.mode-chip.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--text-on-primary);
  font-weight: 600;
}

.font-ctrl {
  display: flex;
  gap: 10rpx;
}

.font-btn {
  width: 64rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 10rpx;
}

.font-btn:active {
  background: var(--bg-muted);
}

/* 朗读条 */
.playbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 10rpx 36rpx 6rpx;
  padding: 18rpx 28rpx;
  background: var(--color-primary);
  border-radius: 999rpx;
  box-shadow: var(--shadow-primary);
  transition: transform 0.15s var(--ease-out);
}

.playbar:active {
  transform: scale(0.98);
}

.play-btn {
  width: 0;
  height: 0;
  border-left: 28rpx solid #fff;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  margin-left: 8rpx;
}

.play-btn.paused {
  width: 26rpx;
  height: 30rpx;
  border: none;
  margin-left: 8rpx;
  background: #fff;
  border-radius: 4rpx;
  box-shadow: inset 12rpx 0 0 -4rpx var(--color-primary);
}

.play-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.play-status {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 正文 */
.reader-body {
  padding: 16rpx 36rpx 20rpx;
}

.sent {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  transition: background 0.3s var(--ease-out);
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.sent.active {
  background: var(--color-highlight-soft);
}

.sent-no {
  width: 40rpx;
  font-size: 22rpx;
  color: var(--text-quaternary);
  padding-top: 6rpx;
  flex-shrink: 0;
}

.sent-main {
  flex: 1;
  min-width: 0;
}

.sent-en {
  font-family: Georgia, 'Times New Roman', serif;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.seg {
  transition: background 0.15s var(--ease-out);
}

.seg-key {
  background: linear-gradient(180deg, transparent 60%, var(--color-highlight-soft) 60%);
}

.seg:active {
  background: var(--color-highlight);
  border-radius: 6rpx;
}

.sent-zh {
  margin-top: 10rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 读完印章 */
.reader-stamp {
  position: fixed;
  right: 60rpx;
  bottom: 220rpx;
  padding: 10rpx 22rpx;
  border: 4rpx solid var(--color-accent);
  border-radius: 10rpx;
  color: var(--color-accent);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  transform: rotate(-8deg);
  background: var(--color-accent-bg);
  opacity: 0.9;
  z-index: 5;
  pointer-events: none;
}

/* 关键词面板 */
.keyword-panel {
  margin: 20rpx 36rpx 0;
  padding: 24rpx 28rpx;
  background: var(--color-primary-bg-light);
  border: 2rpx dashed var(--border-strong);
  border-radius: 16rpx;
}

.keyword-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.keyword-panel-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

.keyword-collect-all {
  font-size: 22rpx;
  color: var(--color-primary);
}

.keyword-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.keyword-chip {
  padding: 8rpx 20rpx;
  font-size: 26rpx;
  font-family: Georgia, 'Times New Roman', serif;
  color: var(--color-primary-dark);
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 999rpx;
  transition: all 0.15s var(--ease-out);
}

.keyword-chip.collected {
  background: var(--color-success);
  border-color: var(--color-success);
  color: #fff;
}

.keyword-chip-check {
  font-size: 22rpx;
}

.finish-btn {
  margin: 30rpx 36rpx 0;
}

.finish-btn.done {
  background: var(--color-success);
  box-shadow: none;
}

/* 词义弹窗 */
.word-mask {
  position: fixed;
  inset: 0;
  background: rgba(43, 38, 32, 0.4);
  z-index: 20;
}

.word-popup {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 34%;
  z-index: 21;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 20rpx;
  padding: 44rpx 40rpx 30rpx;
  box-shadow: var(--shadow-lg);
  animation: popIn 0.25s var(--ease-spring);
}

@keyframes popIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.word-popup-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.word-popup-word {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.word-popup-phonetic {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.word-popup-play {
  margin-left: auto;
  font-size: 34rpx;
}

.word-popup-meaning {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: var(--color-primary-dark);
  font-weight: 600;
}

.word-popup-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: var(--color-accent);
  background: var(--color-accent-bg);
  border-radius: 999rpx;
}

.word-popup-close {
  margin-top: 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
}
