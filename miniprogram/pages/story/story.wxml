<!-- pages/story/story.wxml -->
<view class="page">

  <!-- ═══════ 故事列表 ═══════ -->
  <block wx:if="{{stage === 'list'}}">
    <view class="page-head">
      <view class="page-head-title serif">双语阅读</view>
      <view class="page-head-sub">逐句朗读 · 中英对照 · 点词即查</view>
    </view>

    <view class="story-grid">
      <view
        class="story-card"
        wx:for="{{storyList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openStory"
      >
        <view class="story-top">
          <view class="story-level {{item.level}}">{{item.levelLabel}}</view>
          <view class="story-finished" wx:if="{{item.finished}}">✓ 已读</view>
        </view>
        <view class="story-etag serif">{{item.enTitle}}</view>
        <view class="story-title">{{item.title}}</view>
        <view class="story-intro">{{item.intro}}</view>
        <view class="story-meta">
          <text class="story-meta-item">{{item.category}}</text>
          <text class="story-meta-dot">·</text>
          <text class="story-meta-item">{{item.sentenceCount}} 句</text>
          <text class="story-meta-dot">·</text>
          <text class="story-meta-item">{{item.wordCount}} 关键词</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ═══════ 阅读器 ═══════ -->
  <block wx:if="{{stage === 'read' && story}}">
    <view class="reader-head">
      <view class="reader-back" bindtap="backToList">‹ 返回</view>
      <view class="reader-title serif">{{story.enTitle}}</view>
    </view>

    <!-- 工具栏 -->
    <view class="reader-toolbar">
      <view class="mode-chips">
        <view class="mode-chip {{showMode === 'both' ? 'active' : ''}}" data-mode="both" bindtap="onModeChange">中英</view>
        <view class="mode-chip {{showMode === 'en' ? 'active' : ''}}" data-mode="en" bindtap="onModeChange">英文</view>
        <view class="mode-chip {{showMode === 'zh' ? 'active' : ''}}" data-mode="zh" bindtap="onModeChange">中文</view>
      </view>
      <view class="font-ctrl">
        <view class="font-btn" data-delta="-2" bindtap="changeFontSize">A-</view>
        <view class="font-btn" data-delta="2" bindtap="changeFontSize">A+</view>
      </view>
    </view>

    <!-- 朗读条 -->
    <view class="playbar" bindtap="togglePlay">
      <view class="play-btn {{playing ? 'paused' : ''}}"></view>
      <view class="play-text">{{playing ? '暂停朗读' : '播放全文'}}</view>
      <view class="play-status" wx:if="{{playing}}">正在朗读 第 {{playSeq + 1}} / {{sentViews.length}} 句</view>
      <view class="play-status" wx:else>点任意句子从该句开始</view>
    </view>

    <!-- 正文 -->
    <view class="reader-body">
      <view
        class="sent {{item.active ? 'active' : ''}} sent-{{item.index}}"
        wx:for="{{sentViews}}"
        wx:key="index"
        data-idx="{{item.index}}"
        bindtap="onSentenceTap"
      >
        <view class="sent-no serif">{{item.index + 1}}</view>
        <view class="sent-main">
          <view class="sent-en" style="font-size: {{fontSize}}rpx; line-height: {{fontSize + 14}}rpx;">
            <text
              wx:for="{{item.segments}}"
              wx:for-item="seg"
              wx:key="index"
              class="seg {{seg.isKey ? 'seg-key' : ''}}"
              data-w="{{seg.text}}"
              catchtap="onWordTap"
            >{{seg.text}} </text>
          </view>
          <view class="sent-zh" wx:if="{{showMode !== 'en'}}" style="font-size: {{showMode === 'zh' ? fontSize : 26}}rpx;">{{item.zh}}</view>
        </view>
      </view>
    </view>

    <!-- 读完印章 -->
    <view class="reader-stamp" wx:if="{{finished}}">已读完</view>

    <!-- 关键词面板 -->
    <view class="keyword-panel">
      <view class="keyword-panel-head">
        <view class="keyword-panel-title">本篇关键词</view>
        <view class="keyword-collect-all" bindtap="collectAll">一键收入生词本</view>
      </view>
      <view class="keyword-chips">
        <view
          class="keyword-chip {{collectedWords.includes(item.word) ? 'collected' : ''}}"
          wx:for="{{keyWords}}"
          wx:key="word"
          data-idx="{{index}}"
          bindtap="collectWord"
        >{{item.word}}<text class="keyword-chip-check" wx:if="{{collectedWords.includes(item.word)}}"> ✓</text></view>
      </view>
    </view>

    <view class="btn-primary finish-btn {{finished ? 'done' : ''}}" bindtap="markFinished">
      {{finished ? '✓ 本篇已完成' : '标记读完本篇'}}
    </view>

    <!-- 词义弹窗 -->
    <view class="word-mask" wx:if="{{wordPopup}}" bindtap="closeWordPopup"></view>
    <view class="word-popup card-taped" wx:if="{{wordPopup}}" catchtap="noop">
      <view class="word-popup-head">
        <view class="word-popup-word serif">{{wordPopup.word}}</view>
        <view class="word-popup-phonetic" wx:if="{{wordPopup.phonetic}}">{{wordPopup.phonetic}}</view>
        <view class="word-popup-play" bindtap="onWordPopupPlay">🔊</view>
      </view>
      <view class="word-popup-meaning">{{wordPopup.meaning}}</view>
      <view class="word-popup-tag" wx:if="{{wordPopup.isKey}}">本篇关键词</view>
      <view class="word-popup-close" bindtap="closeWordPopup">关闭</view>
    </view>
  </block>
</view>
