/* pages/challenge/challenge.wxss */
.container {
  padding: 20rpx 24rpx 60rpx;
  min-height: 100vh;
}

/* ═════════ 关卡列表页 ═════════ */

.area-header {
  display: flex;
  align-items: center;
  background: linear-gradient(145deg, #4A90D9 0%, #6FB1F0 100%);
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.15);
}

.area-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.area-info {
  flex: 1;
}

.area-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.area-stats {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.area-switch {
  font-size: 26rpx;
  color: #4A90D9;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
}

/* 徽章预览 */
.badges-row {
  margin-bottom: 24rpx;
}

.badges-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #5A6072;
  margin-bottom: 12rpx;
}

.badges-scroll {
  white-space: nowrap;
}

.badges-list {
  display: inline-flex;
  gap: 16rpx;
}

/* 关卡网格 */
.levels-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.level-card {
  width: calc(33.33% - 14rpx);
  aspect-ratio: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  transition: all 0.2s;
  position: relative;
}

.level-card:active {
  transform: scale(0.96);
}

.level-card.locked {
  opacity: 0.5;
  background: #F0F2F5;
}

.level-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #4A90D9;
}

.level-card.locked .level-num {
  color: #B0B6C0;
}

.level-stars {
  margin-top: 8rpx;
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 20rpx;
  color: #D0D5DD;
}

.star.active {
  color: #F5A623;
}

.star-dim {
  font-size: 20rpx;
  color: #D0D5DD;
}

.level-lock {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 24rpx;
}

/* 规则卡片 */
.rule-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.rule-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2430;
  margin-bottom: 12rpx;
}

.rule-item {
  font-size: 24rpx;
  color: #8A8F99;
  line-height: 1.8;
}

/* ═════════ 答题页 ═════════ */

.play-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.play-back {
  font-size: 36rpx;
  color: #B0B6C0;
  padding: 8rpx 16rpx;
}

.play-level {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2430;
}

.play-progress-text {
  font-size: 26rpx;
  color: #8A8F99;
}

.play-progress-bar {
  height: 12rpx;
  background: #E3E9F2;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.play-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #6FB1F0);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.play-stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.play-stat {
  font-size: 26rpx;
  color: #5A6072;
  background: #F0F2F5;
  border-radius: 12rpx;
  padding: 6rpx 18rpx;
}

.combo-stat {
  color: #F5A623;
  background: #FFF6E5;
  font-weight: 600;
}

/* 题型标签 */
.qtype-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #4A90D9;
  background: #EAF2FC;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
  margin-bottom: 20rpx;
}

/* 题目卡片 */
.q-word-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #F8FAFF 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.10);
  margin-bottom: 30rpx;
  position: relative;
}

.q-word {
  font-size: 56rpx;
  font-weight: 700;
  color: #1F2430;
  letter-spacing: 2rpx;
}

.q-meaning {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2430;
  line-height: 1.5;
}

.q-meaning-large {
  font-size: 44rpx;
  font-weight: 600;
  color: #1F2430;
  line-height: 1.5;
}

.q-phonetic {
  font-size: 28rpx;
  color: #4A90D9;
  margin-top: 12rpx;
}

.q-example {
  font-size: 26rpx;
  color: #5A6072;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EEF1F6;
  line-height: 1.6;
}

.q-audio {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-size: 36rpx;
}

/* 四选一选项 */
.choice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.choice-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.choice-item:active {
  opacity: 0.85;
}

.choice-item.correct {
  background: #E8F5E9;
  border-color: #34A853;
}

.choice-item.wrong {
  background: #FFEBEE;
  border-color: #F44336;
}

.choice-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0F2F5;
  color: #8A8F99;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.choice-item.correct .choice-letter {
  background: #34A853;
  color: #FFFFFF;
}

.choice-item.wrong .choice-letter {
  background: #F44336;
  color: #FFFFFF;
}

.choice-text {
  font-size: 32rpx;
  color: #1F2430;
  flex: 1;
}

.choice-text.word-text {
  font-weight: 600;
  letter-spacing: 1rpx;
}

.choice-item.correct .choice-text {
  color: #2E7D32;
  font-weight: 600;
}

.choice-item.wrong .choice-text {
  color: #C62828;
}

/* 拼写模式 */
.spell-input {
  height: 88rpx;
  border: 2rpx solid #E3E9F2;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  text-align: center;
  color: #1F2430;
  background: #FFFFFF;
  margin-bottom: 20rpx;
}

.spell-meaning {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2430;
  line-height: 1.5;
}

.spell-phonetic {
  font-size: 28rpx;
  color: #4A90D9;
  margin-top: 12rpx;
}

.spell-audio-row {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

.spell-audio-btn {
  font-size: 28rpx;
  color: #4A90D9;
  background: #EAF2FC;
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
}

.spell-input.correct {
  border-color: #34A853;
  color: #2E7D32;
}

.spell-input.wrong {
  border-color: #F44336;
  color: #C62828;
}

/* 连击鼓励特效 */
.combo-overlay {
  position: fixed;
  top: 40%;
  left: 0;
  right: 0;
  z-index: 50;
  text-align: center;
  pointer-events: none;
}

.combo-bounce {
  display: inline-block;
  font-size: 48rpx;
  font-weight: 700;
  color: #F5A623;
  text-shadow: 0 4rpx 20rpx rgba(245, 166, 35, 0.3);
  animation: comboBounce 0.6s ease;
}

@keyframes comboBounce {
  0% { transform: scale(0.3); opacity: 0; }
  50% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* ═════════ 通关结算页 ═════════ */

.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F6F8FC;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.result-content {
  width: 100%;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: resultPop 0.5s ease;
}

@keyframes resultPop {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2430;
  margin-bottom: 30rpx;
}

/* 星级 */
.result-stars-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.result-star {
  font-size: 72rpx;
  color: #D0D5DD;
  animation: starPop 0.5s ease;
}

.result-star:nth-child(1) { animation-delay: 0.2s; }
.result-star:nth-child(2) { animation-delay: 0.4s; }
.result-star:nth-child(3) { animation-delay: 0.6s; }

.result-star.active {
  color: #F5A623;
  text-shadow: 0 4rpx 20rpx rgba(245, 166, 35, 0.3);
}

@keyframes starPop {
  0% { transform: scale(0); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* 正确率环 */
.result-ring-wrap {
  margin-bottom: 40rpx;
}

.result-ring {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.8s ease;
}

.result-ring-inner {
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.result-rate {
  font-size: 60rpx;
  font-weight: 800;
  color: #4A90D9;
  line-height: 1;
}

.result-rate-label {
  font-size: 22rpx;
  color: #8A8F99;
  margin-top: 8rpx;
}

/* 统计行 */
.result-stats-row {
  display: flex;
  gap: 50rpx;
  margin-bottom: 30rpx;
}

.result-stat {
  text-align: center;
}

.result-stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2430;
}

.result-stat-label {
  font-size: 22rpx;
  color: #8A8F99;
  margin-top: 6rpx;
}

/* 新徽章 */
.result-new-badge {
  background: linear-gradient(145deg, #FFF8E1, #FFE082);
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  animation: badgeShake 0.6s ease;
}

@keyframes badgeShake {
  0%, 100% { transform: rotate(0); }
  25% { transform: rotate(-3deg); }
  75% { transform: rotate(3deg); }
}

.new-badge-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #E65100;
  margin-bottom: 8rpx;
}

.new-badge-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.new-badge-icon {
  font-size: 48rpx;
}

.new-badge-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #E65100;
}

/* 解锁提示 */
.result-unlock-tip {
  font-size: 28rpx;
  color: #34A853;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* 操作按钮 */
.result-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
}

.result-btn {
  flex: 1;
  padding: 24rpx 0;
  min-width: 180rpx;
  font-size: 30rpx;
}

/* 加载状态 */
.loading-state {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(246, 248, 252, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 300;
}

.loading-icon {
  font-size: 80rpx;
  animation: pulse 1.2s ease infinite;
}

.loading-text {
  font-size: 30rpx;
  color: #8A8F99;
  margin-top: 20rpx;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
}

/* 通用按钮 */
.btn-primary {
  background: #4A90D9;
  color: #FFFFFF;
  text-align: center;
  border-radius: 16rpx;
  font-weight: 600;
}

.btn-secondary {
  background: #EAF2FC;
  color: #4A90D9;
  text-align: center;
  border-radius: 16rpx;
  font-weight: 600;
}
