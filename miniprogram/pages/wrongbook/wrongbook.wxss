/* pages/wrongbook/wrongbook.wxss */
.container {
  padding: 0 24rpx 60rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.header-count {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: #B84A3E;
  padding: 10rpx 20rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E5F1E9, #C8E6C9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-check {
  width: 40rpx;
  height: 24rpx;
  border-right: 6rpx solid #3E8E5E;
  border-bottom: 6rpx solid #3E8E5E;
  transform: rotate(45deg);
  margin-top: -8rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 700;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
}

.empty-btn {
  margin-top: 50rpx;
  background: #2F5746;
  color: var(--bg-card);
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 80rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(47, 87, 70, 0.3);
}

.empty-btn:active {
  opacity: 0.85;
}

/* 生词列表 */
.word-list {
  padding-top: 10rpx;
}

.word-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(88, 70, 42, 0.03);
}

.word-main {
  flex: 1;
}

.word-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.word-meaning {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.word-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.word-play {
  font-size: 24rpx;
  color: #2F5746;
  background: #E9F0EB;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  font-weight: 600;
  transition: transform 0.15s var(--ease-out);
}

.word-play:active {
  transform: scale(0.9);
}

.word-remove {
  font-size: 32rpx;
  color: #B84A3E;
  padding: 8rpx 12rpx;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-quaternary);
}

/* ─── 导出按钮与隐藏画布 ─── */
.header-actions {
  display: flex;
  align-items: center;
}

.export-btn {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-primary, #4A7A5C);
  border: 1rpx solid var(--color-primary, #4A7A5C);
  border-radius: 999rpx;
  margin-right: 16rpx;
}

.clear-btn {
  /* 原有样式保持 */
}

.export-canvas-hidden {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 420px;
  height: 700px;
  pointer-events: none;
}

.export-canvas {
  width: 420px;
  height: 700px;
}
