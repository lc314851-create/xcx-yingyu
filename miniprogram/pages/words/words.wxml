<!-- pages/words/words.wxml -->
<!-- 隐藏 canvas（导出今日单词表图片用） -->
<view class="export-canvas-hidden">
  <canvas type="2d" id="exportCanvas" class="export-canvas"></canvas>
</view>
<view class="container">
  <!-- 顶部词书信息 -->
  <view class="book-bar">
    <view class="book-bar-top" bindtap="changeBook">
      <view class="book-bar-name">{{bookName}}</view>
      <view class="book-bar-stats">已掌握 {{masteredCount}}/{{bookTotal}}</view>
    </view>
    <view class="book-bar-controls">
      <view class="mode-group">
        <view class="mode-chip active" bindtap="onModeTap">{{modeLabels[modeIndex]}} ▾</view>
        <view class="book-bar-switch {{studyMode !== 'all' ? 'scope-on' : ''}}" bindtap="onSelectWordClass">{{wordClassLabel}}</view>
        <view class="book-bar-switch" bindtap="onToggleOrderMode">{{orderMode === 'random' ? '随机' : '顺序'}}</view>
        <view class="book-bar-switch" bindtap="onChangeBatchSize">{{batchSize}} 个/轮</view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-dots">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
    <view class="loading-text">词库加载中...</view>
  </view>

  <!-- 进度条（快速学习阶段隐藏，检测阶段恢复） -->
  <view class="progress-row" wx:if="{{!loading && totalCount > 0 && !showResult && !quickLearning}}">
    <view class="status-tag {{statusLabel === '复习' ? 'review' : (statusLabel === '巩固' ? 'solidify' : (statusLabel === '高危词' ? 'danger' : ''))}}">{{statusLabel}}</view>
    <view class="progress-text">{{currentIndex + 1}} / {{totalCount}}</view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{totalCount > 0 ? (currentIndex + 1) / totalCount * 100 : 0}}%"></view>
    </view>
  </view>

  <!-- 自定义选择弹框（模式/范围/每轮个数） -->
  <view class="report-mask" wx:if="{{showSheet}}" bindtap="closeSheet"></view>
  <view class="report-panel sheet-panel" wx:if="{{showSheet}}">
    <view class="sheet-head">
      <view class="sheet-tape"></view>
      <view class="sheet-title">{{sheetTitle}}</view>
      <view class="sheet-close" bindtap="closeSheet">关闭</view>
    </view>
    <view class="sheet-options">
      <view
        class="sheet-option {{item.active ? 'active' : ''}}"
        wx:for="{{sheetOptions}}"
        wx:key="label"
        data-index="{{index}}"
        data-type="{{sheetType}}"
        bindtap="onSheetSelect"
      >
        <text>{{item.label}}</text>
        <text class="sheet-check" wx:if="{{item.active}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && totalCount === 0}}">
    <view class="empty-icon-wrap">
      <view class="empty-icon-book"></view>
    </view>
    <view class="empty-text">本词书已全部掌握！</view>
    <view class="empty-sub">可以切换其他词书继续学习</view>
    <view class="btn-primary empty-btn" bindtap="changeBook">选择词书</view>
  </view>

  <!-- ═════════ 卡片翻面模式 ═════════ -->
  <block wx:if="{{!loading && totalCount > 0 && activeMode === 'card' && !showResult}}">
    <view class="card-scene" bindtap="flipCard" wx:if="{{queue[currentIndex]}}">
      <view class="card-3d {{isFlipped ? 'flipped' : ''}}">
        <!-- 正面：单词 -->
        <view class="card-face card-front">
          <view class="word-main">{{queue[currentIndex].word}}</view>
          <view class="word-phonetic-front" wx:if="{{queue[currentIndex].phonetic}}">{{queue[currentIndex].phonetic}}</view>
          <view class="flip-hint">点击卡片翻面查看释义</view>
        </view>
        <!-- 背面：释义 + 例句（内容超长时内部滚动，不盖住下方按钮） -->
        <view class="card-face card-back">
          <scroll-view scroll-y class="card-back-scroll">
            <view class="card-back-inner">
              <view class="word-main back-word">{{queue[currentIndex].word}}</view>
              <view class="word-phonetic">{{queue[currentIndex].phonetic}}</view>
              <view class="word-meaning">{{queue[currentIndex].meaning}}</view>
              <view class="word-example" wx:if="{{queue[currentIndex].example}}">{{queue[currentIndex].example}}</view>
              <!-- ECDICT 扩展字段 -->
              <view class="word-extra" wx:if="{{queue[currentIndex].root || queue[currentIndex].synonyms || queue[currentIndex].antonyms || queue[currentIndex].relatedWords || queue[currentIndex].star}}">
                <view class="word-extra-row" wx:if="{{queue[currentIndex].root}}"><text class="extra-label">词根：</text><text class="extra-text">{{queue[currentIndex].root}}{{queue[currentIndex].rootGloss ? ' · ' + queue[currentIndex].rootGloss : ''}}</text></view>
                <view class="word-extra-row" wx:if="{{queue[currentIndex].synonyms}}"><text class="extra-label">同义：</text><text class="extra-text">{{queue[currentIndex].synonyms}}</text></view>
                <view class="word-extra-row" wx:if="{{queue[currentIndex].antonyms}}"><text class="extra-label">反义：</text><text class="extra-text">{{queue[currentIndex].antonyms}}</text></view>
                <view class="word-extra-row" wx:if="{{queue[currentIndex].relatedWords}}"><text class="extra-label">形近：</text><text class="extra-text">{{queue[currentIndex].relatedWords}}</text></view>
                <view class="word-extra-row" wx:if="{{queue[currentIndex].star > 0}}"><text class="extra-label">词频：</text><text class="extra-text">{{['','★','★★','★★★','★★★★','★★★★★'][queue[currentIndex].star] || ''}}</text></view>
              </view>
              <view class="word-galaxy-link" wx:if="{{queue[currentIndex].root || queue[currentIndex].relatedWords}}" catchtap="goGalaxy">漫游词族 ›</view>
              <view class="word-report-link {{reportedMap[queue[currentIndex].word] ? 'done' : ''}}" catchtap="openReport">{{reportedMap[queue[currentIndex].word] ? '已上报纠错 ✓' : '词条有误？报告一下'}}</view>
              <view class="flip-hint">点击返回正面</view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>

    <!-- 发音按钮 -->
    <view class="audio-row">
      <view class="audio-btn" catchtap="onPlayAudio">发音</view>
      <view class="accent-toggle" catchtap="onToggleAccent">{{accent === 'uk' ? '英音' : '美音'}}</view>
    </view>

    <!-- 操作按钮 -->
    <view class="actions" wx:if="{{!revealAfterUnknown}}">
      <view class="btn-secondary mark-btn" bindtap="markUnknown">不认识</view>
      <view class="btn-primary mark-btn" bindtap="markKnown">认识 ✓</view>
    </view>
    <!-- 不认识→已展示释义：看完再走 -->
    <view class="actions" wx:if="{{revealAfterUnknown}}">
      <view class="btn-primary mark-btn reveal-next-btn" bindtap="onRevealNext">下一个 ›</view>
    </view>
  </block>

  <!-- ═════════ 快速模式 · 学习阶段（纯浏览，无标记） ═════════ -->
  <block wx:if="{{!loading && totalCount > 0 && quickLearning && activeMode === 'quick' && !showResult}}">
    <view class="list-tip">点单词听发音 · 默认都认识，点 × 标记不认识</view>
    <view class="list-wrap">
      <view
        class="list-item {{quickUnknown[item.word] ? 'item-unknown' : ''}}"
        wx:for="{{queue}}"
        wx:key="word"
        data-word="{{item.word}}"
        bindtap="onListTap"
      >
        <view class="list-item-main">
          <view class="list-item-head">
            <view class="list-item-word">{{item.word}}</view>
            <view class="list-item-phonetic" wx:if="{{item.phonetic}}">{{item.phonetic}}</view>
          </view>
          <view class="list-item-meaning">{{item.meaning}}</view>
          <view class="list-item-root" wx:if="{{item.root}}">词根 {{item.root}}{{item.rootGloss ? ' · ' + item.rootGloss : ''}}</view>
        </view>
        <view class="list-item-x {{quickUnknown[item.word] ? 'marked' : ''}}" data-word="{{item.word}}" catchtap="onQuickMark">✗</view>
      </view>
    </view>
    <view class="quick-actions">
      <view class="quick-finish-btn" bindtap="onQuickFinish">完成</view>
      <view class="quick-start-btn" bindtap="onNextRound">继续 ›</view>
    </view>
    <view class="quick-start-hint">共 {{totalCount}} 词 · 未标记的记为认识，标 × 的会尽快再安排复习</view>
  </block>

  <!-- ═════════ 四选一模式 ═════════ -->
  <block wx:if="{{!loading && totalCount > 0 && activeMode === 'choice' && !showResult}}">
    <view class="choice-question">
      <view class="choice-prompt">下列哪个是该单词的释义？</view>
      <view class="choice-word {{queue[currentIndex].word.length > 12 ? 'choice-word-xs' : (queue[currentIndex].word.length > 8 ? 'choice-word-sm' : '')}}">{{queue[currentIndex].word}}</view>
      <view class="choice-sub-row">
        <view class="choice-phonetic" wx:if="{{queue[currentIndex].phonetic}}">{{queue[currentIndex].phonetic}}</view>
        <view class="audio-btn-sm" catchtap="onPlayAudio">发声</view>
      </view>
    </view>

    <view class="choice-options">
      <view
        class="choice-item {{choiceSelected === index ? (choiceCorrect ? 'correct' : 'wrong') : ''}} {{choiceSelected !== -1 && choiceOptions[index].isCorrect ? 'correct' : ''}}"
        wx:for="{{choiceOptions}}"
        wx:key="index"
        data-idx="{{index}}"
        bindtap="onChoiceSelect"
      >
        <view class="choice-letter">{{['A','B','C','D'][index]}}</view>
        <view class="choice-text">{{item.meaning}}</view>
      </view>
    </view>

    <!-- 不认识：直接揭示正确答案，按答错记录 -->
    <view class="actions button-compact" wx:if="{{choiceSelected === -1}}">
      <view class="btn-secondary mark-btn" bindtap="onChoiceDontKnow">不认识</view>
    </view>
    <!-- 不认识→已揭示正确答案：看完记住再走 -->
    <view class="actions button-compact" wx:if="{{choiceSelected === -2}}">
      <view class="btn-primary mark-btn reveal-next-btn" bindtap="onChoiceNext">下一个 ›</view>
    </view>
  </block>

  <!-- ═════════ 拼写模式 ═════════ -->
  <block wx:if="{{!loading && totalCount > 0 && activeMode === 'spell' && !showResult}}">
    <view class="spell-card {{spellFeedback !== 'none' ? (spellFeedback === 'correct' ? 'feedback-correct' : 'feedback-wrong') : ''}}">
      <view class="spell-prompt">请拼写出这个单词</view>
      <view class="spell-meaning">{{queue[currentIndex].meaning}}</view>
      <view class="spell-phonetic" wx:if="{{queue[currentIndex].phonetic}}">{{queue[currentIndex].phonetic}}</view>
      <view class="spell-example" wx:if="{{queue[currentIndex].example}}">{{queue[currentIndex].example}}</view>

      <input
        class="spell-input"
        type="text"
        placeholder="在此输入单词..."
        value="{{spellInput}}"
        bindinput="onSpellInput"
        bindconfirm="onSpellSubmit"
        confirm-type="done"
        adjust-position="{{true}}"
      />

      <view class="spell-feedback-text" wx:if="{{spellFeedback === 'correct'}}">✓ 正确！</view>
      <view class="spell-feedback-text" wx:if="{{spellFeedback === 'wrong'}}">✗ 正确答案：{{queue[currentIndex].word}}</view>

      <view class="spell-audio-row">
        <view class="audio-btn" catchtap="onPlayAudio">听发音</view>
      </view>
    </view>

    <view class="actions" wx:if="{{spellFeedback === 'none'}}">
      <view class="btn-primary mark-btn" bindtap="onSpellSubmit">提交</view>
    </view>
  </block>

  <!-- ═════════ 全屏结果页 ═════════ -->
  <view class="result-overlay" wx:if="{{showResult}}">
    <view class="result-content">
      <view class="result-title">本轮完成</view>
      <!-- 进度环 -->
      <view class="result-ring-wrap">
        <view class="result-ring" style="background: conic-gradient(var(--color-primary) {{resultRate}}%, var(--border-light) {{resultRate}}%);">
          <view class="result-ring-inner">
            <view class="result-rate">{{resultRate}}%</view>
            <view class="result-rate-label">正确率</view>
          </view>
        </view>
      </view>
      <!-- 统计 -->
      <view class="result-stats-row">
        <view class="result-stat">
          <view class="result-stat-num">{{totalCount}}</view>
          <view class="result-stat-label">总词数</view>
        </view>
        <view class="result-stat">
          <view class="result-stat-num result-correct">{{knownCount}}</view>
          <view class="result-stat-label">认识</view>
        </view>
        <view class="result-stat">
          <view class="result-stat-num result-wrong">{{unknownCount}}</view>
          <view class="result-stat-label">不认识</view>
        </view>
      </view>
      <view class="result-praise">{{resultPraise}}</view>
      <view class="result-export" bindtap="onExportToday">导出今日单词表 ›</view>
      <view class="result-actions">
        <view class="btn-secondary result-btn" bindtap="onResultBack">返回首页</view>
        <view class="btn-secondary result-btn share-btn" bindtap="onSharePoster">分享打卡</view>
      </view>
      <view class="result-actions">
        <view class="btn-secondary result-btn" bindtap="onResultReviewRound">复习本轮</view>
        <view class="btn-primary result-btn" bindtap="onResultRestart">再来一轮</view>
      </view>
      <!-- 学习提醒入口已下线（2026-08-31：一次性订阅需重复授权，体验繁琐）
      <view class="result-reminder" wx:if="{{!reminderSubscribed}}" bindtap="onSubscribeReminder">
        <text class="result-reminder-text">点此开启学习提醒</text>
        <text class="result-reminder-sub">次日早上提醒 · 一次授权一条，学完可再次开启</text>
      </view>
      -->
    </view>
  </view>

  <!-- 纠错上报弹窗 -->
  <view class="report-mask" wx:if="{{showReport}}" bindtap="closeReport"></view>
  <view class="report-panel" wx:if="{{showReport}}">
    <view class="report-head">
      <view class="report-title">报告词条问题</view>
      <view class="report-word serif">{{queue[currentIndex].word}}</view>
    </view>
    <view class="report-types">
      <view
        class="report-type {{reportType === 'meaning' ? 'active' : ''}}"
        data-type="meaning"
        bindtap="onReportType"
      >释义有误</view>
      <view
        class="report-type {{reportType === 'phonetic' ? 'active' : ''}}"
        data-type="phonetic"
        bindtap="onReportType"
      >音标有误</view>
      <view
        class="report-type {{reportType === 'example' ? 'active' : ''}}"
        data-type="example"
        bindtap="onReportType"
      >例句/翻译有误</view>
      <view
        class="report-type {{reportType === 'other' ? 'active' : ''}}"
        data-type="other"
        bindtap="onReportType"
      >其他问题</view>
    </view>
    <textarea
      class="report-desc"
      placeholder="补充说明（选填，限 200 字）"
      value="{{reportDesc}}"
      maxlength="200"
      bindinput="onReportDesc"
    ></textarea>
    <view class="report-actions">
      <view class="btn-secondary report-btn" bindtap="closeReport">取消</view>
      <view class="btn-primary report-btn" bindtap="submitReport">提交反馈</view>
    </view>
    <view class="report-tip">你的反馈会帮助所有学习者——词库共建人</view>
  </view>
</view>
