/* pages/words/words.wxss */
.container {
  padding: 20rpx 24rpx 60rpx;
}

/* ═══ 词书信息条 ═══ */
.book-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.book-bar-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.book-bar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.book-bar-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2430;
}

.book-bar-stats {
  font-size: 24rpx;
  color: #8A8F99;
}

.book-bar-switch {
  font-size: 26rpx;
  color: #4A90D9;
  padding: 8rpx 20rpx;
  background: #EAF2FC;
  border-radius: 20rpx;
}

/* 练习模式切换组 */
.mode-group {
  display: flex;
  background: #F0F2F5;
  border-radius: 20rpx;
  padding: 4rpx;
}

.mode-chip {
  font-size: 22rpx;
  color: #8A8F99;
  padding: 8rpx 16rpx;
  border-radius: 18rpx;
  transition: all 0.2s;
}

.mode-chip.active {
  background: #4A90D9;
  color: #FFFFFF;
  font-weight: 600;
}

/* ═══ 进度条 ═══ */
.progress-row {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  gap: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  color: #4A90D9;
  background: #EAF2FC;
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  min-width: 60rpx;
  text-align: center;
}

.status-tag.review {
  color: #F5A623;
  background: #FFF6E5;
}

.status-tag.solidify {
  color: #34A853;
  background: #E8F5E9;
}

.progress-text {
  font-size: 26rpx;
  color: #8A8F99;
  min-width: 90rpx;
}

.progress-bar {
  flex: 1;
  height: 14rpx;
  background: #E3E9F2;
  border-radius: 7rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #4A90D9;
  border-radius: 7rpx;
  transition: width 0.3s ease;
}

/* ═══════════════════════════════════ */
/* 卡片翻面 3D 动画                      */
/* ═══════════════════════════════════ */

.card-scene {
  perspective: 1200rpx;
  margin-bottom: 20rpx;
  /* 确保 absolute 子元素不溢出到下方按钮 */
  position: relative;
  overflow: visible;
}

.card-3d {
  position: relative;
  width: 100%;
  min-height: 400rpx;
  transform-style: preserve-3d;
  transition: transform 0.6s ease-in-out;
}

.card-3d.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  min-height: 400rpx;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.card-front {
  background: linear-gradient(145deg, #FFFFFF 0%, #F8FAFF 100%);
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.10);
}

.card-back {
  background: linear-gradient(145deg, #4A90D9 0%, #6FB1F0 100%);
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.20);
  transform: rotateY(180deg);
  color: #FFFFFF;
}

.word-main {
  font-size: 64rpx;
  font-weight: 700;
  color: #1F2430;
  letter-spacing: 2rpx;
}

.card-back .word-main {
  color: #FFFFFF;
}

.back-word {
  font-size: 48rpx;
}

.word-phonetic-front {
  font-size: 30rpx;
  color: #4A90D9;
  margin-top: 20rpx;
}

.card-back .word-phonetic {
  color: rgba(255, 255, 255, 0.85);
  font-size: 30rpx;
  margin-top: 16rpx;
}

.card-back .word-meaning {
  color: #FFFFFF;
  font-size: 34rpx;
  margin-top: 16rpx;
  line-height: 1.5;
}

.card-back .word-example {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  line-height: 1.6;
}

.flip-hint {
  font-size: 24rpx;
  color: #B0B6C0;
  margin-top: 40rpx;
}

.card-back .flip-hint {
  color: rgba(255, 255, 255, 0.6);
}

/* ═══ 发音按钮 ═══ */
.audio-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin: 16rpx 0 0;
  /* 确保 audio-row 不被 3D 卡片的 absolute 层覆盖 */
  position: relative;
  z-index: 10;
}

.audio-btn {
  font-size: 28rpx;
  color: #4A90D9;
  background: #EAF2FC;
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
}

.audio-btn:active {
  opacity: 0.8;
}

.accent-toggle {
  font-size: 24rpx;
  color: #8A8F99;
  background: #F0F2F5;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
}

/* ═══ 操作按钮 ═══ */
.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.mark-btn {
  flex: 1;
  padding: 24rpx 0;
  font-size: 32rpx;
}

/* ═══════════════════════════════════ */
/* 四选一模式样式                        */
/* ═══════════════════════════════════ */

.choice-question {
  background: linear-gradient(145deg, #FFFFFF 0%, #F8FAFF 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.10);
  margin-bottom: 30rpx;
}

.choice-prompt {
  font-size: 26rpx;
  color: #8A8F99;
  margin-bottom: 24rpx;
}

.choice-word-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.choice-word {
  font-size: 56rpx;
  font-weight: 700;
  color: #1F2430;
  letter-spacing: 2rpx;
}

.choice-phonetic {
  font-size: 28rpx;
  color: #4A90D9;
}

.audio-btn-sm {
  font-size: 36rpx;
  padding: 8rpx 12rpx;
}

.choice-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.choice-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.choice-item:active {
  opacity: 0.85;
}

.choice-item.correct {
  background: #E8F5E9;
  border-color: #34A853;
}

.choice-item.wrong {
  background: #FFEBEE;
  border-color: #F44336;
}

.choice-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0F2F5;
  color: #8A8F99;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.choice-item.correct .choice-letter {
  background: #34A853;
  color: #FFFFFF;
}

.choice-item.wrong .choice-letter {
  background: #F44336;
  color: #FFFFFF;
}

.choice-text {
  font-size: 32rpx;
  color: #1F2430;
  flex: 1;
}

.choice-item.correct .choice-text {
  color: #2E7D32;
  font-weight: 600;
}

.choice-item.wrong .choice-text {
  color: #C62828;
}

/* ═══════════════════════════════════ */
/* 拼写模式样式                          */
/* ═══════════════════════════════════ */

.spell-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #F8FAFF 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.10);
  margin-bottom: 30rpx;
  border: 3rpx solid transparent;
  transition: border-color 0.3s;
}

.spell-card.feedback-correct {
  border-color: #34A853;
  background: linear-gradient(145deg, #E8F5E9 0%, #F1F8E9 100%);
}

.spell-card.feedback-wrong {
  border-color: #F44336;
  background: linear-gradient(145deg, #FFEBEE 0%, #FFF8F8 100%);
}

.spell-prompt {
  font-size: 26rpx;
  color: #8A8F99;
  margin-bottom: 24rpx;
}

.spell-meaning {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2430;
  line-height: 1.5;
}

.spell-phonetic {
  font-size: 28rpx;
  color: #4A90D9;
  margin-top: 12rpx;
}

.spell-example {
  font-size: 26rpx;
  color: #5A6072;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EEF1F6;
  line-height: 1.6;
}

.spell-input {
  margin-top: 40rpx;
  height: 88rpx;
  border: 2rpx solid #E3E9F2;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  text-align: center;
  color: #1F2430;
  background: #FFFFFF;
}

.spell-card.feedback-correct .spell-input {
  border-color: #34A853;
  color: #2E7D32;
}

.spell-card.feedback-wrong .spell-input {
  border-color: #F44336;
  color: #C62828;
}

.spell-feedback-text {
  font-size: 30rpx;
  margin-top: 20rpx;
  font-weight: 600;
}

.spell-card.feedback-correct .spell-feedback-text {
  color: #34A853;
}

.spell-card.feedback-wrong .spell-feedback-text {
  color: #F44336;
}

.spell-audio-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

/* ═══════════════════════════════════ */
/* 全屏结果页                            */
/* ═══════════════════════════════════ */

.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F6F8FC;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.result-content {
  width: 100%;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: resultPop 0.5s ease;
}

@keyframes resultPop {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2430;
  margin-bottom: 60rpx;
}

/* 进度环 */
.result-ring-wrap {
  margin-bottom: 50rpx;
}

.result-ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.8s ease;
}

.result-ring-inner {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.result-rate {
  font-size: 72rpx;
  font-weight: 800;
  color: #4A90D9;
  line-height: 1;
}

.result-rate-label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
}

/* 统计行 */
.result-stats-row {
  display: flex;
  gap: 60rpx;
  margin-bottom: 40rpx;
}

.result-stat {
  text-align: center;
}

.result-stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #1F2430;
}

.result-stat-num.result-correct {
  color: #34A853;
}

.result-stat-num.result-wrong {
  color: #F44336;
}

.result-stat-label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
}

.result-praise {
  font-size: 32rpx;
  color: #5A6072;
  margin-bottom: 50rpx;
  text-align: center;
}

.result-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  width: 100%;
}

.result-btn {
  flex: 1;
  padding: 24rpx 0;
  min-width: 200rpx;
}

.share-btn {
  flex: 1 1 100%;
}

/* ═══ 加载状态 ═══ */
.loading-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.loading-icon {
  font-size: 80rpx;
  animation: pulse 1.2s ease infinite;
}

.loading-text {
  font-size: 30rpx;
  color: #8A8F99;
  margin-top: 20rpx;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

/* ═══ 空状态 ═══ */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2430;
  margin-top: 30rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #8A8F99;
  margin-top: 12rpx;
}

.empty-btn {
  margin: 40rpx auto 0;
  width: 60%;
}

/* ═══ 词书选择弹窗 ═══ */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F6F8FC;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.25s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 1rpx solid #EEF1F6;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2430;
}

.picker-close {
  font-size: 36rpx;
  color: #B0B6C0;
  padding: 4rpx 12rpx;
}

.picker-list {
  flex: 1;
  overflow: hidden;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F2F5;
}

.picker-item.active {
  background: #EAF2FC;
}

.picker-item-name {
  font-size: 32rpx;
  color: #1F2430;
}

.picker-item.active .picker-item-name {
  color: #4A90D9;
  font-weight: 600;
}

.picker-item-check {
  font-size: 36rpx;
  color: #4A90D9;
  font-weight: 600;
}
