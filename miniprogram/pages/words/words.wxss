/* pages/words/words.wxss */
.container {
  padding: 20rpx 24rpx 60rpx;
}

/* ═══ 词书信息条 ═══ */
.book-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.book-bar-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.book-bar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.book-bar-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2430;
}

.book-bar-stats {
  font-size: 24rpx;
  color: #8A8F99;
}

.book-bar-switch {
  font-size: 26rpx;
  color: #2F5746;
  padding: 10rpx 22rpx;
  background: #E9F0EB;
  border-radius: 20rpx;
  font-weight: 600;
  transition: transform 0.15s var(--ease-out);
}

.book-bar-switch:active {
  transform: scale(0.93);
}

/* 练习模式切换组 */
.mode-group {
  display: flex;
  background: #F0F2F5;
  border-radius: 20rpx;
  padding: 4rpx;
}

.mode-chip {
  font-size: 22rpx;
  color: #8A8F99;
  padding: 10rpx 18rpx;
  border-radius: 18rpx;
  font-weight: 500;
  transition: all 0.2s var(--ease-out);
}

.mode-chip.active {
  background: #2F5746;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(47, 87, 70, 0.3);
}

/* ═══ 进度条 ═══ */
.progress-row {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  gap: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  color: #2F5746;
  background: #E9F0EB;
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  min-width: 60rpx;
  text-align: center;
}

.status-tag.review {
  color: #C98F2C;
  background: #F9F1DE;
}

.status-tag.solidify {
  color: #3E8E5E;
  background: #E5F1E9;
}

.progress-text {
  font-size: 26rpx;
  color: #8A8F99;
  min-width: 90rpx;
}

.progress-bar {
  flex: 1;
  height: 14rpx;
  background: #E3E9F2;
  border-radius: 7rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #2F5746;
  border-radius: 7rpx;
  transition: width 0.3s ease;
}

/* ═══════════════════════════════════ */
/* 卡片翻面 3D 动画                      */
/* ═══════════════════════════════════ */

.card-scene {
  perspective: 1200rpx;
  margin-bottom: 20rpx;
  /* 确保 absolute 子元素不溢出到下方按钮 */
  position: relative;
  overflow: visible;
}

.card-3d {
  position: relative;
  width: 100%;
  min-height: 400rpx;
  transform-style: preserve-3d;
  transition: transform 0.6s ease-in-out;
}

.card-3d.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  min-height: 400rpx;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

/* 正面：横线便签单词卡，顶部貼和纸膠帶 */
.card-front {
  background-color: #FFFDF6;
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 62rpx,
    rgba(47, 87, 70, 0.10) 62rpx,
    rgba(47, 87, 70, 0.10) 64rpx
  ),
  linear-gradient(to right,
    transparent 0,
    transparent 72rpx,
    rgba(184, 74, 62, 0.18) 72rpx,
    rgba(184, 74, 62, 0.18) 74rpx,
    transparent 74rpx
  );
  border: 2rpx solid #E0D7C2;
  box-shadow: 0 12rpx 40rpx rgba(88, 70, 42, 0.12);
}

.card-front::before {
  content: "";
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-2deg);
  width: 150rpx;
  height: 38rpx;
  background: rgba(242, 201, 76, 0.6);
  border-left: 2rpx dashed rgba(255, 255, 255, 0.7);
  border-right: 2rpx dashed rgba(255, 255, 255, 0.7);
  box-shadow: 0 3rpx 6rpx rgba(88, 70, 42, 0.12);
  z-index: 2;
}

/* 背面：墨绿卡纸 + 车线内框 */
.card-back {
  background: #24473A;
  border: 2rpx solid #1C3A2F;
  box-shadow: 0 12rpx 40rpx rgba(36, 71, 58, 0.30);
  transform: rotateY(180deg);
  color: #F9F6EE;
}

.card-back::before {
  content: "";
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 2rpx dashed rgba(249, 246, 238, 0.25);
  border-radius: 16rpx;
  pointer-events: none;
}

.word-main {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 72rpx;
  font-weight: 700;
  color: #2B2620;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.card-back .word-main {
  color: #F9F6EE;
}

.back-word {
  font-size: 48rpx;
}

.word-phonetic-front {
  font-size: 30rpx;
  color: #2F5746;
  margin-top: 20rpx;
}

.card-back .word-phonetic {
  color: rgba(255, 255, 255, 0.85);
  font-size: 30rpx;
  margin-top: 16rpx;
}

.card-back .word-meaning {
  color: #FFFFFF;
  font-size: 34rpx;
  margin-top: 16rpx;
  line-height: 1.5;
}

.card-back .word-example {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  line-height: 1.6;
}

/* ECDICT 扩展字段 */
.word-extra {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  text-align: left;
}

.word-extra-row {
  font-size: 24rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.8);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.extra-label {
  color: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}

.extra-text {
  color: rgba(255, 255, 255, 0.9);
}

.flip-hint {
  font-size: 24rpx;
  color: #9A9078;
  margin-top: 40rpx;
  letter-spacing: 2rpx;
}

.card-back .flip-hint {
  color: rgba(255, 255, 255, 0.6);
}

/* ═══ 发音按钮 ═══ */
.audio-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin: 16rpx 0 0;
  /* 确保 audio-row 不被 3D 卡片的 absolute 层覆盖 */
  position: relative;
  z-index: 10;
}

.audio-btn {
  font-size: 28rpx;
  color: #2F5746;
  background: #E9F0EB;
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
  font-weight: 600;
  transition: transform 0.15s var(--ease-out), background 0.15s var(--ease-out);
}

.audio-btn:active {
  transform: scale(0.93);
  background: #DCE8DE;
}

.accent-toggle {
  font-size: 24rpx;
  color: #8A8F99;
  background: #F0F2F5;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  font-weight: 500;
  transition: transform 0.15s var(--ease-out);
}

.accent-toggle:active {
  transform: scale(0.93);
}

/* ═══ 操作按钮 ═══ */
.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.mark-btn {
  flex: 1;
  padding: 24rpx 0;
  font-size: 32rpx;
  transition: transform 0.15s var(--ease-out);
}

.mark-btn:active {
  transform: scale(0.97) translateY(2rpx);
}

/* ═══════════════════════════════════ */
/* 四选一模式样式                        */
/* ═══════════════════════════════════ */

.choice-question {
  background: linear-gradient(145deg, #FFFFFF 0%, #F8FAFF 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(47, 87, 70, 0.12);
  margin-bottom: 30rpx;
}

.choice-prompt {
  font-size: 26rpx;
  color: #8A8F99;
  margin-bottom: 24rpx;
}

.choice-word-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.choice-word {
  font-size: 56rpx;
  font-weight: 800;
  color: #1F2430;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.choice-phonetic {
  font-size: 28rpx;
  color: #2F5746;
}

.audio-btn-sm {
  font-size: 36rpx;
  padding: 8rpx 12rpx;
}

.choice-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.choice-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out);
}

.choice-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.choice-item.correct {
  background: #E5F1E9;
  border-color: #3E8E5E;
}

.choice-item.wrong {
  background: #F6E8E4;
  border-color: #F44336;
}

.choice-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0F2F5;
  color: #8A8F99;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.choice-item.correct .choice-letter {
  background: #3E8E5E;
  color: #FFFFFF;
}

.choice-item.wrong .choice-letter {
  background: #F44336;
  color: #FFFFFF;
}

.choice-text {
  font-size: 32rpx;
  color: #1F2430;
  flex: 1;
}

.choice-item.correct .choice-text {
  color: #2E7D32;
  font-weight: 600;
}

.choice-item.wrong .choice-text {
  color: #C62828;
}

/* ═══════════════════════════════════ */
/* 拼写模式样式                          */
/* ═══════════════════════════════════ */

.spell-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #F8FAFF 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(47, 87, 70, 0.12);
  margin-bottom: 30rpx;
  border: 3rpx solid transparent;
  transition: border-color 0.3s, background 0.3s;
}

.spell-card.feedback-correct {
  border-color: #3E8E5E;
  background: linear-gradient(145deg, #E5F1E9 0%, #F1F8E9 100%);
}

.spell-card.feedback-wrong {
  border-color: #F44336;
  background: linear-gradient(145deg, #F6E8E4 0%, #FFF8F8 100%);
}

.spell-prompt {
  font-size: 26rpx;
  color: #8A8F99;
  margin-bottom: 24rpx;
}

.spell-meaning {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2430;
  line-height: 1.5;
}

.spell-phonetic {
  font-size: 28rpx;
  color: #2F5746;
  margin-top: 12rpx;
}

.spell-example {
  font-size: 26rpx;
  color: #5A6072;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EEF1F6;
  line-height: 1.6;
}

.spell-input {
  margin-top: 40rpx;
  height: 88rpx;
  border: 2rpx solid #E3E9F2;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  text-align: center;
  color: #1F2430;
  background: #FFFFFF;
}

.spell-card.feedback-correct .spell-input {
  border-color: #3E8E5E;
  color: #2E7D32;
}

.spell-card.feedback-wrong .spell-input {
  border-color: #F44336;
  color: #C62828;
}

.spell-feedback-text {
  font-size: 30rpx;
  margin-top: 20rpx;
  font-weight: 600;
}

.spell-card.feedback-correct .spell-feedback-text {
  color: #3E8E5E;
}

.spell-card.feedback-wrong .spell-feedback-text {
  color: #F44336;
}

.spell-audio-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

/* ═══════════════════════════════════ */
/* 全屏结果页                            */
/* ═══════════════════════════════════ */

.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F7F3EA;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.result-content {
  width: 100%;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: resultPop 0.5s ease;
}

@keyframes resultPop {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2430;
  margin-bottom: 60rpx;
}

/* 进度环 */
.result-ring-wrap {
  margin-bottom: 50rpx;
}

.result-ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.8s ease;
}

.result-ring-inner {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.result-rate {
  font-size: 72rpx;
  font-weight: 800;
  color: #2F5746;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.result-rate-label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
}

/* 统计行 */
.result-stats-row {
  display: flex;
  gap: 60rpx;
  margin-bottom: 40rpx;
}

.result-stat {
  text-align: center;
}

.result-stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #1F2430;
  font-variant-numeric: tabular-nums;
}

.result-stat-num.result-correct {
  color: #3E8E5E;
}

.result-stat-num.result-wrong {
  color: #F44336;
}

.result-stat-label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
}

.result-praise {
  font-size: 32rpx;
  color: #5A6072;
  margin-bottom: 50rpx;
  text-align: center;
}

.result-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  width: 100%;
}

.result-btn {
  flex: 1;
  padding: 24rpx 0;
  min-width: 200rpx;
  transition: transform 0.15s var(--ease-out);
}

.result-btn:active {
  transform: scale(0.97) translateY(2rpx);
}

.share-btn {
  flex: 1 1 100%;
}

/* ═══ 加载状态 ═══ */
.loading-state {
  text-align: center;
  padding: 160rpx 40rpx;
}

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2F5746;
  animation: loadingDot 1.2s ease infinite;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes loadingDot {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.loading-text {
  font-size: 28rpx;
  color: #8A8F99;
  font-weight: 500;
}

/* ═══ 空状态 ═══ */
.empty-state {
  text-align: center;
  padding: 160rpx 40rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 30rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E9F0EB, #D4E5F7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-book {
  width: 48rpx;
  height: 40rpx;
  border: 4rpx solid #2F5746;
  border-radius: 4rpx;
  position: relative;
}

.empty-icon-book::after {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 16rpx;
  background: #2F5746;
}

.empty-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2430;
}

.empty-sub {
  font-size: 26rpx;
  color: #8A8F99;
  margin-top: 12rpx;
}

.empty-btn {
  margin: 40rpx auto 0;
  width: 60%;
}

/* ═══ 词书选择弹窗 ═══ */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F7F3EA;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.25s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 1rpx solid #EEF1F6;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2430;
}

.picker-close {
  font-size: 36rpx;
  color: #B0B6C0;
  padding: 4rpx 12rpx;
}

.picker-list {
  flex: 1;
  overflow: hidden;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F2F5;
}

.picker-item.active {
  background: #E9F0EB;
}

.picker-item-name {
  font-size: 32rpx;
  color: #1F2430;
}

.picker-item.active .picker-item-name {
  color: #2F5746;
  font-weight: 600;
}

.picker-item-check {
  font-size: 36rpx;
  color: #2F5746;
  font-weight: 600;
}

/* 漫游词族入口（卡背） */
.word-galaxy-link {
  display: inline-block;
  margin-top: 24rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  color: #F2C94C;
  border: 2rpx solid rgba(242, 201, 76, 0.6);
  border-radius: 999rpx;
  letter-spacing: 2rpx;
  transition: transform 0.15s var(--ease-out);
}

.word-galaxy-link:active {
  transform: scale(0.94);
  background: rgba(242, 201, 76, 0.12);
}
