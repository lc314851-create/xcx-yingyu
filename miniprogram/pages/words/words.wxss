/* ═══ 加载状态 ═══ */
.loading-state {
  /* 预留与“进度条+卡片+发音+按钮”相近的高度（约 960rpx），
     避免加载完成后内容插入导致整页跳动 */
  min-height: 960rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 40rpx;
  text-align: center;
}

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2F5746;
  animation: loadingDot 1.2s ease infinite;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes loadingDot {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

/* ═══ 空状态 ═══ */
.empty-state {
  text-align: center;
  padding: 160rpx 40rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 30rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E9F0EB, #D4E5F7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-book {
  width: 48rpx;
  height: 40rpx;
  border: 4rpx solid #2F5746;
  border-radius: 4rpx;
  position: relative;
}

.empty-icon-book::after {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 16rpx;
  background: #2F5746;
}

.empty-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
}

.empty-btn {
  margin: 40rpx auto 0;
  width: 60%;
}

/* 漫游词族入口（卡背） */
.word-galaxy-link {
  display: inline-block;
  margin-top: 24rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  color: #F2C94C;
  border: 2rpx solid rgba(242, 201, 76, 0.6);
  border-radius: 999rpx;
  letter-spacing: 2rpx;
  transition: transform 0.15s var(--ease-out);
}

.word-galaxy-link:active {
  transform: scale(0.94);
  background: rgba(242, 201, 76, 0.12);
}

/* 纠错上报入口（卡背） */
.word-report-link {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  border: 2rpx dashed var(--border-strong);
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}

.word-report-link:active {
  transform: scale(0.94);
  background: var(--bg-muted);
}

.word-report-link.done {
  color: var(--color-success);
  border-color: var(--color-success);
  background: var(--color-success-bg);
}

/* ─── 纠错上报弹窗 ─── */
.report-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(43, 38, 32, 0.45);
  z-index: 120;
}

.report-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx 48rpx;
  z-index: 121;
  animation: slideUp 0.3s var(--ease-out); /* 复用 picker 的 slideUp */
}

.report-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.report-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.report-word {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  word-break: break-all;
}

.report-types {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.report-type {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-muted);
  border: 2rpx solid var(--border-default);
  border-radius: var(--radius-pill);
}

.report-type.active {
  color: var(--text-on-primary);
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.report-desc {
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  background: var(--bg-page);
  border: 2rpx solid var(--border-default);
  border-radius: var(--radius-md);
}

.report-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 28rpx;
}

.report-actions .report-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.report-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-quaternary);
}

/* ─── 学习范围筛选按钮激活态 ─── */
.book-bar-switch.scope-on {
  color: var(--color-primary);
  background: rgba(74, 122, 92, 0.14);
  font-weight: 600;
}

/* ─── 结果页导出入口 ─── */
.result-export {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* ─── 隐藏导出画布 ─── */
.export-canvas-hidden {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 340px;
  height: 600px;
  pointer-events: none;
}

.export-canvas {
  width: 340px;
  height: 600px;
}

/* 「不认识」揭示答案后的「下一个」按钮（复用 mark-btn，轻微呼吸动画引导点击） */
.reveal-next-btn {
  flex: 1;
  animation: reveal-pulse 1.6s ease-in-out infinite;
}

@keyframes reveal-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.75; }
}

/* ═════════ 列表平铺模式 ═════════ */
.list-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary, #B0A692);
  margin-bottom: 16rpx;
}

.list-wrap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 40rpx;
}

.list-item {
  display: flex;
  align-items: center;
  background: var(--bg-card, #FFFDF6);
  border: 1rpx solid var(--border-light, #EFE8D8);
  border-radius: 20rpx;
  padding: 24rpx;
  transition: opacity 0.25s ease;
}

.list-item.item-known {
  opacity: 0.42; /* 认识的词折叠置灰，减少视觉噪音 */
}

.list-item.item-unknown {
  border-color: #E4B7A0;
  background: #FDF6F0;
}

.list-item-main {
  flex: 1;
  min-width: 0;
}

.list-item-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.list-item-word {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text, #2B2B26);
  font-family: Georgia, serif;
}

.list-item-phonetic {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #B0A692);
}

.list-item-meaning {
  font-size: 26rpx;
  color: var(--color-text-secondary, #5A5648);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.list-item-root {
  font-size: 22rpx;
  color: #7C9C8B;
  margin-top: 6rpx;
}

.list-item-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
}

.list-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  text-align: center;
  line-height: 1.3;
}

.list-btn-no {
  background: #F6E8DF;
  color: #B4634A;
}

.list-btn-ok {
  background: var(--color-primary, #2F5746);
  color: #FFFDF6;
}

.list-item-done {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: var(--color-primary, #2F5746);
}

.item-unknown .list-item-done {
  color: #B4634A;
}

/* ═════════ ⚙ 设置弹层（复用 report-panel 弹层基调） ═════════ */
.settings-panel {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.settings-row-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary, #B0A692);
  margin: 20rpx 0 12rpx;
}

.settings-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.settings-option {
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #F5F0E4;
  color: var(--color-text-secondary, #5A5648);
  border: 1rpx solid transparent;
}

.settings-option.active {
  background: rgba(47, 87, 70, 0.1);
  color: var(--color-primary, #2F5746);
  border-color: var(--color-primary, #2F5746);
  font-weight: 600;
}

.settings-tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary, #B0A692);
  line-height: 1.6;
}

/* 顶部 ⚙ 按钮微调 */
.settings-chip {
  font-size: 28rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

/* 结果页双行动作按钮间距微调 */
.result-actions + .result-actions {
  margin-top: 16rpx;
}

/* ═════════ 自定义选择弹框（手账卡片风） ═════════ */
.sheet-panel {
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  background: var(--bg-page, #F7F3E8);
}

/* 标题行：小胶带装饰 + 标题 */
.sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.sheet-tape {
  width: 72rpx;
  height: 20rpx;
  background: rgba(235, 200, 85, 0.45);
  transform: rotate(-4deg);
  border-radius: 4rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.sheet-close {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--text-tertiary);
  padding: 8rpx 12rpx;
}

.sheet-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.sheet-option {
  width: calc((100% - 40rpx) / 3);
  box-sizing: border-box;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  background: var(--bg-card, #FFFDF6);
  border: 2rpx solid var(--border-light, #EFE8D8);
  border-radius: 20rpx;
  transition: all 0.15s ease;
}

.sheet-option.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #FFFDF6;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(47, 87, 70, 0.25);
}

.sheet-check {
  display: none;
}

.sheet-option.active::after {
  content: '';
  position: absolute;
}

.sheet-option.active .sheet-check {
  display: inline;
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #FFFDF6;
}
