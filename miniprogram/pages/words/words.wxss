/* pages/words/words.wxss */
.container {
  padding: 20rpx 24rpx 60rpx;
}

/* ═══ 词书信息条 ═══ */
.book-bar {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(88, 70, 42, 0.04);
}

.book-bar-top {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 20rpx;
  min-width: 0;
}

.book-bar-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.book-bar-switches {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.book-bar-left {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
  flex-shrink: 1;
}

.book-bar-name {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 300rpx;
}

.book-bar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.book-bar-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.book-bar-stats {
  font-size: 22rpx;
  color: var(--text-tertiary);
  white-space: nowrap;
  flex-shrink: 0;
}

.book-bar-switch {
  font-size: 28rpx;
  color: var(--text-tertiary);
  padding: 10rpx 22rpx;
  white-space: nowrap;
  flex-shrink: 0;
  background: rgba(143, 158, 148, 0.10);
  border-radius: 16rpx;
  font-weight: 500;
  transition: transform 0.15s var(--ease-out);
}

.book-bar-switch:active {
  transform: scale(0.93);
}

/* 练习模式切换组 */
.mode-group {
  display: flex;
  flex-shrink: 0;
  background: var(--border-light);
  border-radius: 20rpx;
  padding: 4rpx;
}


.mode-chip {
  flex: 1;
  text-align: center;
}

.mode-chip {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 10rpx 22rpx;
  white-space: nowrap;
  flex-shrink: 0;
  border-radius: 18rpx;
  font-weight: 500;
  transition: all 0.2s var(--ease-out);
}

.mode-chip.active {
  background: #2F5746;
  color: var(--bg-card);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(47, 87, 70, 0.3);
}

/* ═══ 进度条 ═══ */
.progress-row {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  gap: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  color: #2F5746;
  background: #E9F0EB;
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  min-width: 60rpx;
  text-align: center;
}

.status-tag.review {
  color: #C98F2C;
  background: #F9F1DE;
}

.status-tag.solidify {
  color: #3E8E5E;
  background: #E5F1E9;
}

.status-tag.danger {
  color: #B84A3E;
  background: #FBEAE7;
}

.progress-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  min-width: 90rpx;
}

.progress-bar {
  flex: 1;
  height: 14rpx;
  background: var(--border-light);
  border-radius: 7rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #2F5746;
  border-radius: 7rpx;
  transition: width 0.3s ease;
}

/* ═══════════════════════════════════ */
/* 卡片翻面 3D 动画                      */
/* ═══════════════════════════════════ */

.card-scene {
  perspective: 1200rpx;
  margin-bottom: 20rpx;
  /* 确保 absolute 子元素不溢出到下方按钮 */
  position: relative;
  overflow: visible;
}

.card-3d {
  position: relative;
  width: 100%;
  /* 固定高度：两面都是 absolute，必须由父容器给出确定高度，
     否则背面长内容会溢出卡片、与发音/认识按钮重叠 */
  height: 680rpx;
  transform-style: preserve-3d;
  transition: transform 0.6s ease-in-out;
}

.card-3d.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

/* 正面：横线便签单词卡，顶部貼和纸膠帶 */
.card-front {
  background-color: var(--bg-card);
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 62rpx,
    rgba(47, 87, 70, 0.10) 62rpx,
    rgba(47, 87, 70, 0.10) 64rpx
  ),
  linear-gradient(to right,
    transparent 0,
    transparent 72rpx,
    rgba(184, 74, 62, 0.18) 72rpx,
    rgba(184, 74, 62, 0.18) 74rpx,
    transparent 74rpx
  );
  border: 2rpx solid #E0D7C2;
  box-shadow: 0 12rpx 40rpx rgba(88, 70, 42, 0.12);
}

.card-front::before {
  content: "";
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-2deg);
  width: 150rpx;
  height: 38rpx;
  background: rgba(242, 201, 76, 0.6);
  border-left: 2rpx dashed rgba(255, 255, 255, 0.7);
  border-right: 2rpx dashed rgba(255, 255, 255, 0.7);
  box-shadow: 0 3rpx 6rpx rgba(88, 70, 42, 0.12);
  z-index: 2;
}

/* 背面：墨绿卡纸 + 车线内框（内容超长时内部滚动） */
.card-back {
  background: #24473A;
  border: 2rpx solid #1C3A2F;
  box-shadow: 0 12rpx 40rpx rgba(36, 71, 58, 0.30);
  transform: rotateY(180deg);
  color: #F9F6EE;
  justify-content: flex-start;
  padding: 40rpx 36rpx;
}

.card-back-scroll {
  width: 100%;
  height: 100%;
}

.card-back-inner {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-back::before {
  content: "";
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 2rpx dashed rgba(249, 246, 238, 0.25);
  border-radius: 16rpx;
  pointer-events: none;
}

.word-main {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 72rpx;
  font-weight: 700;
  color: #2B2620;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.card-back .word-main {
  color: #F9F6EE;
}

.back-word {
  font-size: 48rpx;
}

.word-phonetic-front {
  font-size: 30rpx;
  color: #2F5746;
  margin-top: 20rpx;
}

.card-back .word-phonetic {
  color: rgba(255, 255, 255, 0.85);
  font-size: 30rpx;
  margin-top: 16rpx;
}

.card-back .word-meaning {
  color: var(--bg-card);
  font-size: 34rpx;
  margin-top: 16rpx;
  line-height: 1.5;
}

.card-back .word-example {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  line-height: 1.6;
}

/* ECDICT 扩展字段 */
.word-extra {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  text-align: left;
}

.word-extra-row {
  font-size: 24rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.8);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.extra-label {
  color: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}

.extra-text {
  color: rgba(255, 255, 255, 0.9);
}

.flip-hint {
  font-size: 24rpx;
  color: #9A9078;
  margin-top: 40rpx;
  letter-spacing: 2rpx;
}

.card-back .flip-hint {
  color: rgba(255, 255, 255, 0.6);
}

/* ═══ 发音按钮 ═══ */
.audio-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin: 16rpx 0 0;
  /* 确保 audio-row 不被 3D 卡片的 absolute 层覆盖 */
  position: relative;
  z-index: 10;
}

.audio-btn {
  font-size: 28rpx;
  color: #2F5746;
  background: #E9F0EB;
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
  font-weight: 600;
  transition: transform 0.15s var(--ease-out), background 0.15s var(--ease-out);
}

.audio-btn:active {
  transform: scale(0.93);
  background: #DCE8DE;
}

.accent-toggle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  background: var(--border-light);
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  font-weight: 500;
  transition: transform 0.15s var(--ease-out);
}

.accent-toggle:active {
  transform: scale(0.93);
}

/* ═══ 操作按钮 ═══ */
.actions {
  position: relative;
  z-index: 5;
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.actions.button-compact {
  margin-top: 20rpx;
}

.mark-btn {
  flex: 1;
  padding: 24rpx 0;
  font-size: 32rpx;
  transition: transform 0.15s var(--ease-out);
}

.mark-btn:active {
  transform: scale(0.97) translateY(2rpx);
}

/* ═══════════════════════════════════ */
/* 四选一模式样式                        */
/* ═══════════════════════════════════ */

.choice-question {
  background: linear-gradient(145deg, var(--bg-card) 0%, var(--bg-hover) 100%);
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(47, 87, 70, 0.12);
  margin-bottom: 20rpx;
}

.choice-prompt {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 24rpx;
}

.choice-word {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 2rpx;
  line-height: 1.2;
  word-break: break-all;
}

/* 长词自适应缩字号，避免顶边溢出 */
.choice-word-sm {
  font-size: 44rpx;
  letter-spacing: 1rpx;
}

.choice-word-xs {
  font-size: 36rpx;
  letter-spacing: 0;
}

/* 音标 + 发声按钮行（单词下方居中） */
.choice-sub-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.choice-phonetic {
  font-size: 28rpx;
  color: #2F5746;
}

.audio-btn-sm {
  font-size: 36rpx;
  padding: 8rpx 12rpx;
}

.choice-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.choice-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(88, 70, 42, 0.04);
  border: 2rpx solid transparent;
  transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out);
}

.choice-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(88, 70, 42, 0.06);
}

.choice-item.correct {
  background: #E5F1E9;
  border-color: #3E8E5E;
}

.choice-item.wrong {
  background: #F6E8E4;
  border-color: var(--color-danger);
}

.choice-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--border-light);
  color: var(--text-tertiary);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.choice-item.correct .choice-letter {
  background: #3E8E5E;
  color: var(--bg-card);
}

.choice-item.wrong .choice-letter {
  background: var(--color-danger);
  color: var(--bg-card);
}

.choice-text {
  font-size: 32rpx;
  color: var(--text-primary);
  flex: 1;
}

.choice-item.correct .choice-text {
  color: #2E7D32;
  font-weight: 600;
}

.choice-item.wrong .choice-text {
  color: var(--color-danger);
}

/* ═══════════════════════════════════ */
/* 拼写模式样式                          */
/* ═══════════════════════════════════ */

.spell-card {
  background: linear-gradient(145deg, var(--bg-card) 0%, var(--bg-hover) 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(47, 87, 70, 0.12);
  margin-bottom: 30rpx;
  border: 3rpx solid transparent;
  transition: border-color 0.3s, background 0.3s;
}

.spell-card.feedback-correct {
  border-color: #3E8E5E;
  background: linear-gradient(145deg, #E5F1E9 0%, #F1F8E9 100%);
}

.spell-card.feedback-wrong {
  border-color: var(--color-danger);
  background: linear-gradient(145deg, #F6E8E4 0%, #FFF8F8 100%);
}

.spell-prompt {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 24rpx;
}

.spell-meaning {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}

.spell-phonetic {
  font-size: 28rpx;
  color: #2F5746;
  margin-top: 12rpx;
}

.spell-example {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
  line-height: 1.6;
}

.spell-input {
  margin-top: 40rpx;
  height: 88rpx;
  border: 2rpx solid var(--border-light);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  text-align: center;
  color: var(--text-primary);
  background: var(--bg-card);
}

.spell-card.feedback-correct .spell-input {
  border-color: #3E8E5E;
  color: #2E7D32;
}

.spell-card.feedback-wrong .spell-input {
  border-color: var(--color-danger);
  color: var(--color-danger);
}

.spell-feedback-text {
  font-size: 30rpx;
  margin-top: 20rpx;
  font-weight: 600;
}

.spell-card.feedback-correct .spell-feedback-text {
  color: #3E8E5E;
}

.spell-card.feedback-wrong .spell-feedback-text {
  color: var(--color-danger);
}

.spell-audio-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

/* ═══════════════════════════════════ */
/* 全屏结果页                            */
/* ═══════════════════════════════════ */

.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F7F3EA;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.result-content {
  width: 100%;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: resultPop 0.5s ease;
}

@keyframes resultPop {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 60rpx;
}

/* 进度环 */
.result-ring-wrap {
  margin-bottom: 50rpx;
}

.result-ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.8s ease;
}

.result-ring-inner {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(88, 70, 42, 0.06);
}

.result-rate {
  font-size: 72rpx;
  font-weight: 800;
  color: #2F5746;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.result-rate-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* 统计行 */
.result-stats-row {
  display: flex;
  gap: 60rpx;
  margin-bottom: 40rpx;
}

.result-stat {
  text-align: center;
}

.result-stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.result-stat-num.result-correct {
  color: #3E8E5E;
}

.result-stat-num.result-wrong {
  color: var(--color-danger);
}

.result-stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.result-praise {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 50rpx;
  text-align: center;
}

.result-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  width: 100%;
}

.result-btn {
  flex: 1;
  padding: 24rpx 0;
  min-width: 200rpx;
  transition: transform 0.15s var(--ease-out);
}

.result-btn:active {
  transform: scale(0.97) translateY(2rpx);
}

.share-btn {
  flex: 1 1 100%;
}

