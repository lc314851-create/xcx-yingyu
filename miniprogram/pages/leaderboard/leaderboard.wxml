<!-- pages/leaderboard/leaderboard.wxml -->
<view class="container">
  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{tab === 'weekly' ? 'active' : ''}}" data-tab="weekly" bindtap="onTabChange">本周榜</view>
    <view class="tab-item {{tab === 'total' ? 'active' : ''}}" data-tab="total" bindtap="onTabChange">总榜</view>
  </view>

  <!-- 我的排名 -->
  <view class="my-rank-card">
    <view class="my-rank-label">{{tab === 'weekly' ? '我的本周排名' : '我的总榜排名'}}</view>
    <view class="my-rank-info">
      <view class="my-rank-num">{{tab === 'weekly' ? myWeeklyRank : myTotalRank}}</view>
      <view class="my-rank-count">{{tab === 'weekly' ? myWeekly : myTotal}} 词</view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-icon">⏳</view>
    <view class="loading-text">排行榜加载中...</view>
  </view>

  <!-- 排行榜列表 -->
  <view class="rank-list" wx:if="{{!loading}}">
    <!-- 前三名领奖台 -->
    <view class="podium" wx:if="{{currentList.length >= 3}}">
      <view class="podium-item podium-2">
        <view class="podium-avatar">🥈</view>
        <view class="podium-name">{{currentList[1].nickname}}</view>
        <view class="podium-count">{{currentList[1].count}}</view>
      </view>
      <view class="podium-item podium-1">
        <view class="podium-avatar">🥇</view>
        <view class="podium-name">{{currentList[0].nickname}}</view>
        <view class="podium-count">{{currentList[0].count}}</view>
      </view>
      <view class="podium-item podium-3">
        <view class="podium-avatar">🥉</view>
        <view class="podium-name">{{currentList[2].nickname}}</view>
        <view class="podium-count">{{currentList[2].count}}</view>
      </view>
    </view>

    <!-- 完整列表 -->
    <view class="rank-table">
      <view
        class="rank-row {{item.isMe ? 'is-me' : ''}}"
        wx:for="{{currentList}}"
        wx:key="rank"
      >
        <view class="rank-num {{item.rank <= 3 ? 'top-' + item.rank : ''}}">
          {{item.rank <= 3 ? ['🥇','🥈','🥉'][item.rank - 1] : item.rank}}
        </view>
        <view class="rank-name">{{item.nickname}}</view>
        <view class="rank-count">{{item.count}} 词</view>
        <view class="rank-me-tag" wx:if="{{item.isMe}}">我</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{currentList.length === 0}}">
      <view class="empty-icon">📊</view>
      <view class="empty-text">暂无排名数据</view>
      <view class="empty-sub">开始学习，成为第一个上榜的人！</view>
    </view>

    <!-- 云端不可用提示 -->
    <view class="cloud-tip" wx:if="{{!hasCloud}}">
      <view class="cloud-tip-text">⚠️ 云端数据暂不可用，仅显示本地数据</view>
    </view>
  </view>
</view>
