/* pages/leaderboard/leaderboard.wxss */
.container {
  padding: 20rpx 24rpx 60rpx;
  min-height: 100vh;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #8A8F99;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-weight: 500;
  transition: all 0.2s var(--ease-out);
}

.tab-item.active {
  background: #2F5746;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(47, 87, 70, 0.3);
}

/* 我的排名卡片 */
.my-rank-card {
  background: linear-gradient(135deg, #2F5746 0%, #5F8F7A 100%);
  border-radius: 20rpx;
  padding: 30rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(47, 87, 70, 0.15);
}

.my-rank-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.my-rank-info {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-top: 10rpx;
}

.my-rank-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.my-rank-count {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

/* 领奖台 */
.podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
}

.podium-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 30%;
  border-radius: 16rpx 16rpx 0 0;
  padding: 20rpx 0 16rpx;
}

.podium-1 {
  background: linear-gradient(180deg, #FFF8E1 0%, #FFE082 100%);
  height: 200rpx;
}

.podium-2 {
  background: linear-gradient(180deg, #F5F5F5 0%, #E0E0E0 100%);
  height: 170rpx;
}

.podium-3 {
  background: linear-gradient(180deg, #FFF3E0 0%, #FFCC80 100%);
  height: 150rpx;
}

.podium-avatar {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.podium-name {
  font-size: 26rpx;
  color: #1F2430;
  font-weight: 600;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-count {
  font-size: 24rpx;
  color: #5A6072;
  margin-top: 4rpx;
}

/* 排行榜列表 */
.rank-table {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F0F2F5;
  transition: background 0.2s;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-row.is-me {
  background: #E9F0EB;
}

.rank-num {
  width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #8A8F99;
  font-variant-numeric: tabular-nums;
}

.rank-name {
  flex: 1;
  font-size: 30rpx;
  color: #1F2430;
  margin-left: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-count {
  font-size: 28rpx;
  color: #5A6072;
  font-weight: 600;
}

.rank-me-tag {
  font-size: 20rpx;
  color: #FFFFFF;
  background: #2F5746;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2430;
  margin-top: 24rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #8A8F99;
  margin-top: 12rpx;
}

/* 云端不可用提示 */
.cloud-tip {
  margin-top: 30rpx;
  text-align: center;
}

.cloud-tip-text {
  font-size: 24rpx;
  color: #B0B6C0;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.loading-icon {
  font-size: 60rpx;
  animation: pulse 1.2s ease infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #8A8F99;
  margin-top: 16rpx;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

/* 头像（云存储 fileID 直接显示） */
.podium-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid var(--bg-card);
  box-shadow: var(--shadow-md);
  background: var(--bg-muted);
}

.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-light);
  background: var(--bg-muted);
  flex-shrink: 0;
}

.rank-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
}
