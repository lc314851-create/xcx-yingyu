/* pages/galaxy/galaxy.wxss - 词根星系·手账星图 */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ─── 页头 ─── */
.page-head {
  padding: 40rpx 40rpx 10rpx;
}

.page-head-title {
  font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 4rpx;
}

.page-head-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* ─── 加载 / 空态 ─── */
.loading-state, .empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  background: var(--color-primary-light);
  border-radius: 50%;
  animation: dotWave 1.2s ease-in-out infinite;
}

.loading-dot:nth-child(2) { animation-delay: 0.15s; }
.loading-dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes dotWave {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-16rpx); }
}

.loading-text, .empty-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-quaternary);
}

/* ─── 漫游加载条：覆盖在旧星空上，不影响页面布局 ─── */
.loading-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 16rpx 40rpx 0;
  padding: 14rpx 0;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 999rpx;
}

.loading-bar-dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--color-primary-light);
  border-radius: 50%;
  animation: dotWave 1.2s ease-in-out infinite;
}

.loading-bar-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

/* ─── 星系轨道 ─── */
.orbit-scene {
  position: relative;
  margin: 30rpx 40rpx 20rpx;
  height: 700rpx;
}

.orbit-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scaleY(0.82);
  border: 2rpx dashed var(--border-strong);
  border-radius: 50%;
  pointer-events: none;
}

.orbit-ring-inner {
  width: 64%;
  height: 64%;
}

.orbit-ring-outer {
  width: 92%;
  height: 92%;
  opacity: 0.6;
}

/* 中心词卡：贴了胶带的便签 */
.center-card {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 3;
  min-width: 240rpx;
  max-width: 56%;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 16rpx;
  padding: 32rpx 36rpx;
  text-align: center;
  box-shadow: var(--shadow-lg);
  transition: transform 0.15s var(--ease-out);
}

.center-card:active {
  transform: translate(-50%, -50%) scale(0.96);
}

.center-word {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.center-phonetic {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.center-root {
  margin-top: 14rpx;
  font-size: 24rpx;
}

.center-root-tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  border-radius: 999rpx;
  font-weight: 600;
}

.center-root-gloss {
  color: var(--text-secondary);
  margin-left: 8rpx;
}

/* 跨册漫游标注：词来自词根网络的其他词书 */
.center-source {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
  background: rgba(242, 201, 76, 0.18);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  display: inline-block;
}

/* 环绕词节点：纸条钉在轨道上（层级高于中心卡，保证单词不被遮挡） */
.node {
  position: absolute;
  z-index: 4;
  transform: translate(-50%, -50%);
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  font-family: Georgia, 'Times New Roman', serif;
  color: var(--color-primary-dark);
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-bottom: 4rpx solid var(--border-strong);
  border-radius: 10rpx;
  box-shadow: var(--shadow-sm), 0 0 0 6rpx var(--bg-page);
  animation: floaty 4s ease-in-out infinite;
  transition: transform 0.15s var(--ease-out);
  white-space: nowrap;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.node-outer {
  background: var(--color-primary-bg);
  border-color: var(--color-primary-light);
  color: var(--color-primary);
}

.node:active {
  transform: translate(-50%, -50%) scale(0.9);
}

@keyframes floaty {
  0%, 100% { transform: translate(-50%, -50%) translateY(0); }
  50% { transform: translate(-50%, -50%) translateY(-8rpx); }
}

/* ─── 释义卡 ─── */
.meaning-card {
  margin: 10rpx 40rpx 0;
  padding: 26rpx 30rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-left: 6rpx solid var(--color-highlight);
  border-radius: 12rpx;
  box-shadow: var(--shadow-sm);
}

.meaning-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 4rpx;
}

.meaning-text {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

/* ─── 底部操作 ─── */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 40rpx 0;
  gap: 20rpx;
}

.relation-tabs {
  display: flex;
  gap: 14rpx;
  flex: 1;
}

.rel-tab {
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 999rpx;
  transition: all 0.15s var(--ease-out);
}

.rel-tab.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--text-on-primary);
  font-weight: 600;
}

.random-btn {
  padding: 14rpx 26rpx;
  font-size: 26rpx;
  color: var(--color-accent);
  background: var(--color-accent-bg);
  border: 2rpx dashed var(--color-accent);
  border-radius: 999rpx;
  transition: transform 0.15s var(--ease-out);
}

.random-btn:active {
  transform: scale(0.94);
}

/* ═════════ 视图切换 + 平铺词表 ═════════ */
.page-head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.view-toggle {
  flex-shrink: 0;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: rgba(47, 87, 70, 0.08);
  border: 1rpx solid rgba(47, 87, 70, 0.35);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.flat-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin: 16rpx 0;
}


.flat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 30rpx 40rpx;
}

.flat-cell {
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  background: var(--bg-card, #FFFDF6);
  border: 1rpx solid var(--border-light, #EFE8D8);
  border-radius: 16rpx;
  padding: 18rpx 16rpx;
  overflow: hidden;
}

.flat-cell-word {
  font-family: Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flat-cell-meaning {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
