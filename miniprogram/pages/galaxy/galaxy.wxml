<!-- pages/galaxy/galaxy.wxml -->
<view class="page">
  <!-- 顶部说明 + 视图切换 -->
  <view class="page-head page-head-row">
    <view class="page-head-left">
      <view class="page-head-title serif">词根星系</view>
      <view class="page-head-sub">点击任意单词，沿着词族漫游</view>
    </view>
    <view class="view-toggle" bindtap="onToggleView">{{viewMode === 'orbit' ? '平铺词表' : '回星系'}}</view>
  </view>

  <!-- 首次加载（页面无内容）：大块加载态 -->
  <view class="loading-state" wx:if="{{loading && !word}}">
    <view class="loading-dots">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
    <view class="loading-text">正在集结词族...</view>
  </view>

  <!-- 漫游加载：薄加载条，保留旧星空，页面不跳动 -->
  <view class="loading-bar" wx:if="{{loading && word}}">
    <view class="loading-bar-dot"></view>
    <text class="loading-bar-text">正在集结词族…</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && !hasResult}}">
    <view class="empty-text">这本词书还没有可探索的词族</view>
    <view class="empty-sub">切换词书后再来试试</view>
  </view>

  <!-- ═════ 平铺视图：词书全表，点击发声，长按漫游 ═════ -->
  <block wx:if="{{viewMode === 'flat'}}">
    <view class="flat-tip">点单词发声 · 长按以该词为中心漫游星系</view>
    <view class="flat-loading" wx:if="{{flatLoading}}">词表加载中...</view>
    <view class="flat-grid" wx:else>
      <view
        class="flat-cell"
        wx:for="{{flatWords}}"
        wx:key="word"
        data-word="{{item.word}}"
        bindtap="onFlatTap"
        bindlongpress="onFlatLongPress"
      >
        <view class="flat-cell-word">{{item.word}}</view>
        <view class="flat-cell-meaning">{{item.meaning}}</view>
      </view>
    </view>
  </block>

  <block wx:if="{{(!loading || word) && hasResult && viewMode === 'orbit'}}">
    <!-- 星系轨道区 -->
    <view class="orbit-scene">
      <!-- 轨道虚线 -->
      <view class="orbit-ring orbit-ring-inner"></view>
      <view class="orbit-ring orbit-ring-outer"></view>

      <!-- 中心词卡 -->
      <view class="center-card card-taped" bindtap="onPlayCenter">
        <view class="center-word serif">{{word}}</view>
        <view class="center-phonetic" wx:if="{{phonetic}}">{{phonetic}}</view>
        <view class="center-root" wx:if="{{root}}">
          <text class="center-root-tag">{{root}}</text>
          <text class="center-root-gloss" wx:if="{{rootGloss}}">· {{rootGloss}}</text>
        </view>
        <view class="center-source" wx:if="{{!inMainBook}}">跨册词 · 来自词根网络的扩展词</view>
      </view>

      <!-- 环绕词节点 -->
      <view
        class="node {{item.ring === 1 ? 'node-outer' : ''}}"
        wx:for="{{nodes}}"
        wx:key="word"
        data-word="{{item.word}}"
        data-meaning="{{item.meaning}}"
        style="left: {{item.x}}%; top: {{item.y}}%;"
        bindtap="onNodeTap"
        bindlongpress="onNodeLongPress"
      >
        {{item.word}}
      </view>
    </view>

    <!-- 释义卡 -->
    <view class="meaning-card">
      <view class="meaning-label">释义</view>
      <view class="meaning-text">{{meaning}}</view>
    </view>

    <!-- 关系切换 + 随机漫游 -->
    <view class="bottom-bar">
      <view class="relation-tabs">
        <view class="rel-tab {{tab === 'family' ? 'active' : ''}}" data-tab="family" bindtap="onTabChange">
          同根词族 {{familyTotal}}
        </view>
        <view class="rel-tab {{tab === 'similar' ? 'active' : ''}}" data-tab="similar" bindtap="onTabChange">
          形近易混 {{similarTotal}}
        </view>
      </view>
      <view class="random-btn" bindtap="onRandomTap">随机漫游</view>
    </view>
  </block>
</view>
