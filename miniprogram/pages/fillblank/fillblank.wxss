/* pages/fillblank/fillblank.wxss */
.container {
  padding: 20rpx 24rpx 60rpx;
}

/* 顶部统计 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 8rpx 16rpx;
}

.round-info {
  font-size: 28rpx;
  color: #8A8F99;
}

.streak-info {
  font-size: 26rpx;
  color: #F5A623;
  font-weight: 600;
}

/* 进度条 */
.progress-bar-bg {
  width: 100%;
  height: 10rpx;
  background: #EEF1F6;
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.progress-bar-fill {
  height: 100%;
  background: #4A90D9;
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

/* 题目卡片 */
.question-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.question-label {
  font-size: 24rpx;
  color: #4A90D9;
  margin-bottom: 24rpx;
}

.question-en {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2430;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.question-zh {
  font-size: 28rpx;
  color: #5A6072;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.question-author {
  font-size: 24rpx;
  color: #8A8F99;
  text-align: right;
  margin-bottom: 32rpx;
}

/* 选项 */
.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #F6F8FC;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid transparent;
}

.option.correct {
  background: #E8F5E9;
  border-color: #4CAF50;
}

.option.wrong {
  background: #FFEBEE;
  border-color: #F44336;
}

.option-letter {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A90D9;
  flex-shrink: 0;
}

.option.correct .option-letter {
  background: #4CAF50;
  color: #FFFFFF;
}

.option.wrong .option-letter {
  background: #F44336;
  color: #FFFFFF;
}

.option-text {
  font-size: 32rpx;
  color: #1F2430;
}

/* 答题反馈 */
.feedback {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #EEF1F6;
}

.feedback-correct {
  font-size: 30rpx;
  font-weight: 600;
  color: #4CAF50;
  margin-bottom: 12rpx;
}

.feedback-wrong {
  font-size: 30rpx;
  font-weight: 600;
  color: #F44336;
  margin-bottom: 12rpx;
}

.feedback-info {
  font-size: 26rpx;
  color: #5A6072;
  line-height: 1.5;
  margin-top: 12rpx;
}

/* 跳过 */
.skip-btn {
  text-align: center;
  font-size: 26rpx;
  color: #B0B6C0;
  padding: 24rpx 0 8rpx;
}

/* 结果页 */
.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.result-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1F2430;
  margin-bottom: 60rpx;
}

.result-ring-wrap {
  margin-bottom: 40rpx;
}

.result-ring {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-ring-inner {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.result-rate {
  font-size: 56rpx;
  font-weight: 700;
  color: #4A90D9;
}

.result-rate-label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 4rpx;
}

.result-stats {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 60rpx;
}

.result-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90D9;
}

.result-stat-sep {
  font-size: 36rpx;
  color: #B0B6C0;
}

.result-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.result-btn {
  flex: 1;
  padding: 24rpx 0;
}
