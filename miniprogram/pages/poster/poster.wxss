/* pages/poster/poster.wxss */
.container {
  padding: 0 24rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* canvas 隐藏 */
.canvas-hidden {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
}

.poster-canvas {
  width: 300px;
  height: 450px;
}

/* 预览图 */
.poster-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
  margin-bottom: 20rpx;
  min-height: 400rpx;
}

.poster-preview {
  width: 540rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.poster-img {
  width: 100%;
  height: 810rpx;
}

/* 加载状态 */
.poster-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-spin {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #8A8F99;
}

/* 数据概览 */
.data-row {
  display: flex;
  gap: 30rpx;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.data-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.data-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90D9;
}

.data-lbl {
  font-size: 22rpx;
  color: #8A8F99;
  margin-top: 6rpx;
}

/* 按钮 */
.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
}

.save-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.back-btn {
  width: 100%;
}

/* 提示 */
.tip-text {
  font-size: 24rpx;
  color: #B0B6C0;
  margin-top: 30rpx;
  text-align: center;
}
