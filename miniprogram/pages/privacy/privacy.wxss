/* pages/privacy/privacy.wxss */
.container {
  padding: 20rpx 24rpx 60rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2430;
  text-align: center;
}

.update-date {
  font-size: 24rpx;
  color: #8A8F99;
  text-align: center;
  margin-top: 12rpx;
  margin-bottom: 30rpx;
}

.section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2430;
  margin-bottom: 12rpx;
}

.section-text {
  font-size: 26rpx;
  color: #5A6072;
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.list-item {
  font-size: 26rpx;
  color: #5A6072;
  line-height: 1.7;
  margin-top: 8rpx;
  padding-left: 10rpx;
}
