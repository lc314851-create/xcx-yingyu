<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部问候 -->
  <view class="hero">
    <view class="hero-row">
      <view class="hero-title">今天也要加油学英语！</view>
      <view class="hero-search" bindtap="goSearch">🔍</view>
    </view>
    <view class="hero-sub">九层之台，起于垒土</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-num">{{learnedToday}}</view>
      <view class="stat-label">今日已学</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{streakDays}}</view>
      <view class="stat-label">连续打卡</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{totalWords}}</view>
      <view class="stat-label">累计单词</view>
    </view>
  </view>

  <!-- 当前词书 -->
  <view class="card book-card" bindtap="changeBook">
    <view class="book-info">
      <view class="book-name">{{currentBookName}}</view>
      <view class="book-progress">已学 {{knownCount}} · 已掌握 {{masteredCount}} / {{currentBookTotal}}</view>
    </view>
    <view class="book-due" wx:if="{{dueCount > 0}}">{{dueCount}} 个待复习</view>
    <view class="book-arrow">›</view>
  </view>

  <!-- 操作入口 -->
  <view class="actions">
    <view class="btn-primary action-btn" bindtap="goWords">开始学习</view>
    <!-- <view class="btn-secondary action-btn" bindtap="goMine">查看我的</view> -->
  </view>

  <!-- 今日金句 -->
  <view class="card quote-card" wx:if="{{quote}}">
    <view class="quote-tag">📖 每日金句</view>
    <view class="quote-en">{{quote.en}}</view>
    <view class="quote-zh">{{quote.zh}}</view>
    <view class="quote-author" wx:if="{{quote.author}}">— {{quote.author}}</view>
    <view class="quote-words" wx:if="{{quoteWords.length}}">
      <text class="quote-words-label">核心生词：</text>
      <text class="quote-word-item" wx:for="{{quoteWords}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 学习建议 -->
  <view class="card tip-card">
    <view class="tip-title">💡 记忆方法</view>
    <view class="tip-text">每个单词会经过 5 级间隔记忆：答对 1 次→1天后复习，再答对→2天、4天、7天后复习，连续答对 4 次即标记为「已掌握」。答错则重置重来。坚持复习，才能真正记住。</view>
    <view class="tip-divider"></view>
    <view class="tip-title">📊 本周进度</view>
    <view class="tip-text">本周已学 {{weeklyLearned}} 个单词，累计学习 {{totalWords}} 个，坚持就是胜利！</view>
  </view>

  <!-- 自定义词书选择弹窗 -->
  <view class="picker-mask" wx:if="{{showBookPicker}}" bindtap="closeBookPicker"></view>
  <view class="picker-panel" wx:if="{{showBookPicker}}">
    <view class="picker-header">
      <view class="picker-title">选择词书</view>
      <view class="picker-close" bindtap="closeBookPicker">✕</view>
    </view>
    <scroll-view scroll-y class="picker-list">
      <view 
        class="picker-item {{currentBookId === item.id ? 'active' : ''}}" 
        wx:for="{{pickerBooks}}" 
        wx:key="id" 
        data-id="{{item.id}}" 
        data-name="{{item.name}}" 
        bindtap="onSelectBook"
      >
        <view class="picker-item-name">{{item.name}}</view>
        <view class="picker-item-check" wx:if="{{currentBookId === item.id}}">✓</view>
      </view>
    </scroll-view>
  </view>
</view>
