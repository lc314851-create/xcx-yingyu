<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部 hero 区域 -->
  <view class="hero">
    <view class="hero-bg-deco"></view>
    <view class="hero-content">
      <view class="hero-row">
        <view class="hero-greeting">{{greetingText}}</view>
        <view class="hero-search" bindtap="goSearch">
          <view class="hero-search-icon"></view>
        </view>
      </view>
      <view class="hero-title">{{heroTitle}}</view>
      <view class="hero-sub">{{heroSub}}</view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-num">{{learnedToday}}</view>
      <view class="stat-label">今日已学</view>
    </view>
    <view class="stat-card stat-card-accent">
      <view class="stat-num">{{streakDays}}</view>
      <view class="stat-label">连续打卡</view>
      <view class="stat-flame" wx:if="{{streakDays > 0}}"></view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{totalWords}}</view>
      <view class="stat-label">累计单词</view>
    </view>
  </view>

  <!-- 当前词书 -->
  <view class="card book-card" bindtap="changeBook">
    <view class="book-info">
      <view class="book-name">{{currentBookName}}</view>
      <view class="book-progress">
        <text class="book-progress-learned">已学 {{knownCount}}</text>
        <text class="book-progress-sep">·</text>
        <text class="book-progress-mastered">已掌握 {{masteredCount}}</text>
        <text class="book-progress-sep">·</text>
        <text class="book-progress-total">{{currentBookTotal}}</text>
      </view>
      <!-- 进度条 -->
      <view class="book-progress-bar" wx:if="{{currentBookTotal > 0}}">
        <view class="book-progress-fill" style="width: {{currentBookTotal > 0 ? knownCount / currentBookTotal * 100 : 0}}%"></view>
      </view>
    </view>
    <view class="book-right">
      <view class="book-due" wx:if="{{dueCount > 0}}" catchtap="goReview">{{dueCount}} 待复习 ›</view>
      <view class="book-arrow">›</view>
    </view>
  </view>

  <!-- 今日复习计划（SM-2 到期聚合，首页主角卡） -->
  <view class="card plan-card" wx:if="{{showPlanCard}}" bindtap="onPlanTap">
    <view class="plan-head">
      <view class="plan-tag stamp">今日复习计划</view>
      <view class="plan-more" catchtap="goPlan">查看全部 ›</view>
    </view>
    <view class="plan-main" wx:if="{{planDueToday > 0}}">
      <view class="plan-big">
        <text class="plan-num serif">{{planDueToday}}</text>
        <text class="plan-big-text">个词到期待复习</text>
      </view>
      <view class="plan-sub">按你的记忆曲线排期，今天背完遗忘率最低</view>
    </view>
    <view class="plan-main plan-main-ok" wx:else>
      <view class="plan-big plan-big-ok">今天没有到期词</view>
      <view class="plan-sub">间隔记忆的精髓是「到点再背」，去学点新词吧</view>
    </view>
    <view class="plan-forecast">
      <view class="plan-f-item" wx:for="{{planForecast}}" wx:key="label">
        <view class="plan-f-count serif">{{item.count}}</view>
        <view class="plan-f-label">{{item.label}}</view>
      </view>
    </view>
    <view class="btn-primary plan-go" wx:if="{{planDueToday > 0}}" catchtap="goReview">开始今日复习</view>
    <view class="btn-secondary plan-go" wx:else catchtap="goWords">去学新词</view>
  </view>

  <!-- 操作区：招牌玩法（大字卡）+ 学习工具（小格） -->
  <view class="actions">
    <view class="feature-row">
      <view class="feature-card" bindtap="goGalaxy">
        <view class="feature-flag">招牌</view>
        <view class="feature-icon feature-icon-galaxy"></view>
        <view class="feature-body">
          <view class="feature-name">词根星系</view>
          <view class="feature-desc">一次记住一串词</view>
        </view>
      </view>
      <view class="feature-card" bindtap="goMemory">
        <view class="feature-flag">招牌</view>
        <view class="feature-icon feature-icon-memory"></view>
        <view class="feature-body">
          <view class="feature-name">记忆体检</view>
          <view class="feature-desc">算准复习日不忘词</view>
        </view>
      </view>
    </view>

    <view class="tool-row">
      <view class="tool-item" bindtap="goWrongBook">
        <view class="tool-icon tool-icon-wrongbook"></view>
        <view class="tool-name">生词本</view>
      </view>
      <view class="tool-item" bindtap="goVocabTest">
        <view class="tool-icon tool-icon-vocab"></view>
        <view class="tool-name">词汇量测试</view>
      </view>
      <view class="tool-item" bindtap="goSearch">
        <view class="tool-icon tool-icon-search"></view>
        <view class="tool-name">搜单词</view>
      </view>
      <view class="tool-item" bindtap="goTextbook">
        <view class="tool-icon tool-icon-textbook"></view>
        <view class="tool-name">教材同步</view>
      </view>
    </view>
  </view>

  <!-- 今日金句 -->
  <view class="card quote-card" wx:if="{{quote}}">
    <view class="quote-tag-row">
      <view class="quote-tag">每日金句</view>
      <view class="quote-more" bindtap="goQuotes">更多金句 ›</view>
    </view>
    <view class="quote-en">{{quote.en}}</view>
    <view class="quote-zh">{{quote.zh}}</view>
    <view class="quote-author" wx:if="{{quote.author}}">- {{quote.author}}</view>
    <view class="quote-words" wx:if="{{quoteWords.length}}">
      <text class="quote-words-label">核心生词</text>
      <view class="quote-words-list">
        <text class="quote-word-item" wx:for="{{quoteWords}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 学习建议 -->
  <view class="card tip-card">
    <view class="tip-section">
      <view class="tip-title">记忆方法</view>
      <view class="tip-text">每个单词按你的记忆节奏自动排期：答对 1 次后 1 天复习，再答对后 2 天、4 天、7 天，之后每次复习的间隔会根据你的掌握情况逐步拉长；连续答对 4 次即标记为「已掌握」，答错则从头再来。坚持复习，才能真正记住。</view>
    </view>
  </view>
</view>
