/* pages/index/index.wxss */
.container {
  padding-bottom: 40rpx;
}

/* ═══ Hero 区域：手账封面 ═══ */
.hero {
  position: relative;
  background: var(--color-primary);
  padding: 56rpx 40rpx 80rpx;
  color: #F9F6EE;
  overflow: hidden;
}

/* 手账车线内框 */
.hero::before {
  content: "";
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  right: 18rpx;
  bottom: 64rpx;
  border: 2rpx dashed rgba(249, 246, 238, 0.35);
  border-radius: 12rpx;
  pointer-events: none;
}

/* 垂挂膠帶 */
.hero::after {
  content: "";
  position: absolute;
  top: -14rpx;
  right: 84rpx;
  width: 44rpx;
  height: 130rpx;
  background: rgba(242, 201, 76, 0.55);
  border-top: 2rpx dashed rgba(255, 255, 255, 0.7);
  border-bottom: 2rpx dashed rgba(255, 255, 255, 0.7);
  transform: rotate(4deg);
  box-shadow: 0 4rpx 8rpx rgba(88, 70, 42, 0.12);
  pointer-events: none;
}

.hero-bg-deco {
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.hero-bg-deco::after {
  content: "";
  position: absolute;
  top: 40rpx;
  left: 60rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.hero-greeting {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.hero-search {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s var(--ease-out), background 0.15s var(--ease-out);
}

.hero-search:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.3);
}

.hero-search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--bg-card);
  border-radius: 50%;
  position: relative;
}

.hero-search-icon::after {
  content: "";
  position: absolute;
  top: 24rpx;
  left: 20rpx;
  width: 12rpx;
  height: 4rpx;
  background: var(--bg-card);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.hero-title {
  font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 12rpx;
  font-weight: 400;
}

/* ═══ 统计卡片 ═══ */
.stats-row {
  display: flex;
  justify-content: space-between;
  margin-top: -52rpx;
  padding: 0 24rpx;
  position: relative;
  z-index: 2;
}

.stat-card {
  background: var(--bg-card);
  border: 2rpx solid var(--border-default);
  border-radius: 16rpx;
  padding: 28rpx 12rpx;
  width: 31%;
  text-align: center;
  box-shadow: var(--shadow-md);
  position: relative;
  transition: transform 0.2s var(--ease-out);
}

.stat-card:active {
  transform: scale(0.96);
}

.stat-card-accent {
  border-top: 6rpx solid #2F5746;
}

.stat-num {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 50rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.stat-card-accent .stat-num {
  color: #2F5746;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 10rpx;
  font-weight: 500;
}

.stat-flame {
  position: absolute;
  top: 10rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  background: #C98F2C;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  box-shadow: 0 0 8rpx rgba(201, 143, 44, 0.4);
}

/* ═══ 当前词书卡片 ═══ */
.book-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.book-info {
  flex: 1;
  min-width: 0;
}

.book-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.book-progress {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}

.book-progress-learned {
  color: #2F5746;
  font-weight: 600;
}

.book-progress-sep {
  color: #D0D5DD;
}

.book-progress-bar {
  margin-top: 14rpx;
  height: 8rpx;
  background: var(--border-light);
  border-radius: 4rpx;
  overflow: hidden;
}

.book-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2F5746, #5F8F7A);
  border-radius: 4rpx;
  transition: width 0.4s var(--ease-out);
}

.book-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  margin-left: 20rpx;
}

.book-due {
  font-size: 22rpx;
  color: #C98F2C;
  background: #F9F1DE;
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  font-weight: 600;
}

.book-arrow {
  font-size: 40rpx;
  color: var(--text-quaternary);
  font-weight: 300;
  line-height: 1;
}

/* ═══ 操作区：招牌玩法（大字卡）+ 学习工具（小格） ═══ */
.actions {
  padding: 30rpx 24rpx 8rpx;
}

/* 招牌大字卡 */
.feature-row {
  display: flex;
  gap: 20rpx;
}

.feature-card {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--bg-card);
  border-radius: 22rpx;
  padding: 30rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(88, 70, 42, 0.05);
  transition: transform 0.15s var(--ease-out);
}

.feature-card:active {
  transform: scale(0.97);
}

.feature-flag {
  position: absolute;
  top: -12rpx;
  right: 18rpx;
  background: var(--color-highlight);
  color: #5C4A12;
  font-size: 18rpx;
  font-weight: 800;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(88, 70, 42, 0.14);
  z-index: 2;
}

.feature-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
  position: relative;
  flex-shrink: 0;
}

.feature-body {
  min-width: 0;
}

.feature-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.feature-desc {
  font-size: 21rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

/* 词根星系：环绕节点 */
.feature-icon-galaxy {
  background: linear-gradient(135deg, #E9F0EB, #C9DCCE);
}

.feature-icon-galaxy::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background: #2F5746;
  border-radius: 50%;
  box-shadow: 20rpx -14rpx 0 -3rpx #7FA98D,
              -20rpx 10rpx 0 -3rpx #7FA98D,
              10rpx 18rpx 0 -4rpx #7FA98D;
}

.feature-icon-galaxy::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-20deg);
  width: 50rpx;
  height: 30rpx;
  border: 2rpx dashed #7FA98D;
  border-radius: 50%;
}

/* 记忆体检：脑电波 */
.feature-icon-memory {
  background: linear-gradient(135deg, #F6E8E4, #EFCFC5);
}

.feature-icon-memory::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 36rpx;
  height: 28rpx;
  border-bottom: 4rpx solid #B84A3E;
  clip-path: polygon(0 100%, 18% 100%, 28% 40%, 40% 100%, 55% 100%, 66% 20%, 80% 100%, 100% 100%, 100% 116%, 0 116%);
}

/* 学习工具小格 */
.tool-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tool-item {
  flex: 1;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 22rpx 6rpx 18rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(88, 70, 42, 0.04);
  transition: transform 0.15s var(--ease-out);
}

.tool-item:active {
  transform: scale(0.95);
}

.tool-icon {
  width: 52rpx;
  height: 52rpx;
  margin: 0 auto 10rpx;
  border-radius: 14rpx;
  position: relative;
}

.tool-name {
  font-size: 21rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

/* 生词本：书 + 红叉 */
.tool-icon-wrongbook {
  background: linear-gradient(135deg, #FBEAE7, #F3C7C0);
}

.tool-icon-wrongbook::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 22rpx;
  height: 26rpx;
  border: 4rpx solid #B84A3E;
  border-radius: 4rpx;
}

.tool-icon-wrongbook::after {
  content: "";
  position: absolute;
  top: 56%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
  width: 11rpx;
  height: 11rpx;
  background: #B84A3E;
}

/* 词汇量测试：增长柱 */
.tool-icon-vocab {
  background: linear-gradient(135deg, #E9F0EB, #C9DCCE);
}

.tool-icon-vocab::before {
  content: "";
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 22rpx;
  background: #2F5746;
  border-radius: 2rpx;
  box-shadow: 13rpx -6rpx 0 0 #5F8F7A,
              -13rpx -10rpx 0 0 #24473A;
}

/* 搜单词：放大镜 */
.tool-icon-search {
  background: linear-gradient(135deg, #F3EFE2, #E6DEC8);
}

.tool-icon-search::before {
  content: "";
  position: absolute;
  top: 38%;
  left: 38%;
  transform: translate(-50%, -50%);
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #2F5746;
  border-radius: 50%;
}

.tool-icon-search::after {
  content: "";
  position: absolute;
  top: 68%;
  left: 62%;
  transform: rotate(45deg);
  width: 16rpx;
  height: 4rpx;
  background: #2F5746;
  border-radius: 2rpx;
  transform-origin: left center;
}

/* 教材同步：三册书脊 + 书签 */
.tool-icon-textbook {
  background: linear-gradient(135deg, #E9F0EB, #C9DCCE);
}

.tool-icon-textbook::before {
  content: "";
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 26rpx;
  background: #2F5746;
  border-radius: 3rpx 3rpx 2rpx 2rpx;
  box-shadow: 15rpx 0 0 0 #3E7259,
              -15rpx 0 0 0 #5A8A72;
}

.tool-icon-textbook::after {
  content: "";
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 34rpx;
  height: 5rpx;
  background: var(--color-highlight);
  border-radius: 2rpx;
  opacity: 0.9;
}

/* ═══ 今日金句 ═══ */
.quote-card {
  background: linear-gradient(135deg, #FBF8EF 0%, #F4EDDB 100%);
  border: 1rpx solid #E4DCC4;
}

.quote-tag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quote-more {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.quote-tag {
  font-size: 22rpx;
  color: #2F5746;
  background: #E9F0EB;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  font-weight: 600;
}

.quote-fill-btn {
  font-size: 24rpx;
  color: #2F5746;
  padding: 8rpx 18rpx;
  border: 1rpx solid #2F5746;
  border-radius: 20rpx;
  transition: transform 0.15s var(--ease-out);
}

.quote-fill-btn:active {
  transform: scale(0.94);
}

.quote-en {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.quote-zh {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.quote-author {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: right;
}

.quote-words {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E0E8F0;
}

.quote-words-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.quote-words-list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.quote-word-item {
  font-size: 24rpx;
  color: #2F5746;
  background: #E8F1FB;
  border-radius: 8rpx;
  padding: 8rpx 18rpx;
  font-weight: 500;
}

/* ═══ 学习建议 ═══ */
.tip-card {
  margin-top: 20rpx;
}

.tip-section {
  /* 无额外样式，仅用于语义化 */
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.tip-divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 24rpx 0;
}

.tip-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.plan-card {
  padding: 34rpx 36rpx 30rpx;
}

.plan-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.plan-tag {
  transform: rotate(-2deg);
}

.plan-more {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 6rpx 12rpx;
}

.plan-main {
  padding: 10rpx 0 4rpx;
}

.plan-big {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.plan-num {
  font-size: 64rpx;
  color: var(--color-primary);
  line-height: 1;
}

.plan-big-text {
  font-size: 28rpx;
  font-weight: 600;
}

.plan-main-ok .plan-big {
  font-size: 34rpx;
}

.plan-big-ok {
  color: var(--color-success);
}

.plan-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-tertiary);
}

.plan-forecast {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.plan-f-item {
  flex: 1;
  text-align: center;
  background: var(--bg-page);
  border: 2rpx dashed var(--border-light);
  border-radius: var(--radius-md);
  padding: 14rpx 0 10rpx;
}

.plan-f-count {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.plan-f-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.plan-go {
  margin-top: 26rpx;
}

