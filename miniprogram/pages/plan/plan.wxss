/* pages/plan/plan.wxss */
page {
  background: var(--bg-page);
}
.container {
  padding: 24rpx 28rpx 80rpx;
}

/* 概览 */
.hero {
  background: var(--color-primary);
  color: var(--bg-card);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  text-align: center;
}
.hero-title { font-size: 38rpx; font-weight: 600; }
.hero-book { font-size: 24rpx; opacity: .75; margin-top: 8rpx; }
.hero-stats { display: flex; align-items: center; justify-content: center; margin-top: 28rpx; }
.hero-stat { flex: 1; }
.hero-divider { width: 1rpx; height: 56rpx; background: rgba(255,255,255,.25); }
.hero-num { font-size: 48rpx; font-weight: 700; }
.hero-num.accent { color: var(--color-highlight); }
.hero-num.good { color: var(--color-success); }
.hero-label { font-size: 22rpx; opacity: .7; margin-top: 4rpx; }
.hero-tip { margin-top: 26rpx; font-size: 22rpx; line-height: 1.6; opacity: .72; }

/* 分区 */
.section {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  margin-top: 24rpx;
}
.section-header { display: flex; align-items: baseline; justify-content: space-between; }
.section-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.section-sub { font-size: 22rpx; color: var(--text-tertiary); margin-top: 6rpx; }
.section-sub.center { text-align: center; }
.section-more { font-size: 24rpx; color: var(--color-primary); }

/* 记忆盒子分布 */
.box-row { display: flex; align-items: center; margin-top: 24rpx; }
.box-label {
  width: 150rpx;
  font-size: 21rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}
.box-label.mastered { color: var(--color-success); font-weight: 500; }
.box-bar-wrap {
  position: relative;
  flex: 1;
  height: 34rpx;
  background: var(--bg-muted);
  border-radius: 17rpx;
  overflow: hidden;
}
.box-bar {
  height: 100%;
  background: var(--color-primary-light);
  border-radius: 17rpx;
  min-width: 0;
  transition: width .35s ease;
}
.box-bar.mastered { background: var(--color-success); }
.box-count {
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: var(--text-secondary);
}
.box-interval {
  width: 170rpx;
  text-align: right;
  font-size: 19rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

/* 今日到期词 */
.word-card {
  background: var(--bg-hover);
  border-left: 6rpx solid var(--color-highlight);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  margin-top: 18rpx;
}
.word-top { display: flex; align-items: baseline; gap: 14rpx; }
.word-text { font-size: 32rpx; font-weight: 600; color: var(--text-primary); }
.word-phonetic { font-size: 22rpx; color: var(--text-tertiary); }
.word-meaning { font-size: 24rpx; color: var(--text-secondary); margin-top: 6rpx; }
.word-reason {
  font-size: 21rpx;
  color: var(--color-warning);
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}
.word-reason::before {
  content: '';
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: var(--color-highlight);
  margin-right: 10rpx;
  flex-shrink: 0;
}
.more-hint { text-align: center; font-size: 22rpx; color: var(--text-tertiary); margin-top: 20rpx; }

/* 未来7天预测 */
.forecast-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 28rpx;
  height: 140rpx;
}
.forecast-col { flex: 1; text-align: center; }
.forecast-count { font-size: 22rpx; color: var(--text-secondary); min-height: 30rpx; }
.forecast-bar-wrap {
  height: 64rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.forecast-bar {
  width: 28rpx;
  background: var(--border-default);
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  min-height: 4rpx;
}
.forecast-label { font-size: 20rpx; color: var(--text-tertiary); margin-top: 8rpx; }

/* 底部操作 */
.action-btn {
  margin-top: 40rpx;
  background: var(--color-primary);
  color: var(--bg-card);
  text-align: center;
  padding: 26rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.secondary-link {
  text-align: center;
  color: var(--text-tertiary);
  font-size: 24rpx;
  padding: 22rpx;
}
