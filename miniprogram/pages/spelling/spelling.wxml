<!-- pages/spelling/spelling.wxml -->
<view class="container">
  <!-- 顶部进度 -->
  <view class="top-bar">
    <view class="round-info">{{currentIndex + 1}} / {{totalCount}}</view>
    <view class="correct-info">✓ {{correctCount}}</view>
  </view>
  <view class="progress-bar-bg">
    <view class="progress-fill" style="width: {{totalCount > 0 ? (currentIndex + 1) / totalCount * 100 : 0}}%"></view>
  </view>

  <!-- 题目 -->
  <view class="question-card {{feedback === 'correct' ? 'feedback-correct' : ''}} {{feedback === 'wrong' ? 'feedback-wrong' : ''}}" wx:if="{{currentWord && !showResult}}">
    <view class="prompt">请拼出这个单词</view>
    <view class="meaning">{{currentWord.meaning}}</view>
    <view class="phonetic" wx:if="{{currentWord.phonetic}}">{{currentWord.phonetic}}</view>

    <!-- 已输入的字母 -->
    <view class="input-area">
      <view class="input-letters">
        <view class="input-slot" wx:for="{{currentWord.word}}" wx:key="*this">
          <text wx:if="{{index < inputText.length}}" class="input-letter">{{inputText[index]}}</text>
        </view>
      </view>
    </view>

    <!-- 正确答案（答错时显示） -->
    <view class="answer-hint" wx:if="{{feedback === 'wrong'}}">正确答案：{{currentWord.word}}</view>

    <!-- 字母池 -->
    <view class="letter-pool">
      <view
        class="letter-tile {{item.used ? 'used' : ''}}"
        wx:for="{{tiles}}"
        wx:key="originIndex"
        data-idx="{{index}}"
        bindtap="onTapLetter"
      >{{item.letter}}</view>
    </view>

    <!-- 操作按钮 -->
    <view class="actions" wx:if="{{feedback === 'none'}}">
      <view class="btn-secondary action-btn" bindtap="onClear">清空</view>
      <view class="btn-secondary action-btn" bindtap="onBackspace">退格</view>
      <view class="btn-secondary action-btn" bindtap="onSkip">跳过</view>
    </view>
  </view>

  <!-- 结果页 -->
  <view class="result-overlay" wx:if="{{showResult}}">
    <view class="result-content">
      <view class="result-title">练习完成</view>
      <view class="result-ring-wrap">
        <view class="result-ring" style="background: conic-gradient(#4A90D9 {{resultRate}}%, #E3E9F2 {{resultRate}}%);">
          <view class="result-ring-inner">
            <view class="result-rate">{{resultRate}}%</view>
            <view class="result-rate-label">正确率</view>
          </view>
        </view>
      </view>
      <view class="result-stats">
        <text class="result-stat-num">{{correctCount}}</text>
        <text class="result-stat-sep">/</text>
        <text class="result-stat-num">{{totalCount}}</text>
      </view>
      <view class="result-actions">
        <view class="btn-secondary result-btn" bindtap="onBack">返回</view>
        <view class="btn-primary result-btn" bindtap="onRestart">再来一轮</view>
      </view>
    </view>
  </view>
</view>
