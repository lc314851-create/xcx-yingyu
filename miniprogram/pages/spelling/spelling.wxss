/* pages/spelling/spelling.wxss */
.container {
  padding: 20rpx 24rpx 60rpx;
}

/* 顶部进度 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 8rpx 16rpx;
}

.round-info {
  font-size: 28rpx;
  color: #8A8F99;
}

.correct-info {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: 600;
}

.progress-bar-bg {
  width: 100%;
  height: 10rpx;
  background: #EEF1F6;
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.progress-fill {
  height: 100%;
  background: #4A90D9;
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

/* 题目卡片 */
.question-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: background 0.2s;
}

.question-card.feedback-correct {
  background: #E8F5E9;
}

.question-card.feedback-wrong {
  background: #FFEBEE;
}

.prompt {
  font-size: 26rpx;
  color: #4A90D9;
  margin-bottom: 20rpx;
}

.meaning {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2430;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.phonetic {
  font-size: 26rpx;
  color: #8A8F99;
  margin-bottom: 32rpx;
}

/* 已输入字母区 */
.input-area {
  margin-bottom: 32rpx;
}

.input-letters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  padding: 24rpx 0;
  min-height: 100rpx;
}

.input-slot {
  width: 56rpx;
  height: 72rpx;
  border-bottom: 4rpx solid #4A90D9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-letter {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2430;
}

/* 正确答案提示 */
.answer-hint {
  font-size: 28rpx;
  color: #F44336;
  text-align: center;
  margin-bottom: 20rpx;
  font-weight: 600;
}

/* 字母池 */
.letter-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  padding: 16rpx 0 24rpx;
}

.letter-tile {
  width: 72rpx;
  height: 88rpx;
  background: #F0F6FC;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #4A90D9;
  border: 2rpx solid #D4E5F7;
}

.letter-tile.used {
  background: #EEF1F6;
  color: #C0C6D0;
  border-color: #E3E9F2;
  pointer-events: none;
}

.letter-tile:active {
  transform: scale(0.92);
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 18rpx 0;
  font-size: 28rpx;
}

/* 结果页 */
.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.result-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1F2430;
  margin-bottom: 60rpx;
}

.result-ring-wrap {
  margin-bottom: 40rpx;
}

.result-ring {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-ring-inner {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.result-rate {
  font-size: 56rpx;
  font-weight: 700;
  color: #4A90D9;
}

.result-rate-label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 4rpx;
}

.result-stats {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 60rpx;
}

.result-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90D9;
}

.result-stat-sep {
  font-size: 36rpx;
  color: #B0B6C0;
}

.result-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.result-btn {
  flex: 1;
  padding: 24rpx 0;
}
