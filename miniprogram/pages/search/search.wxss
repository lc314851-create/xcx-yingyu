/* pages/search/search.wxss */
.container {
  padding: 20rpx 24rpx 60rpx;
}

/* 搜索框 */
.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 80rpx;
  box-shadow: 0 4rpx 16rpx rgba(88, 70, 42, 0.04);
  border: 2rpx solid transparent;
  transition: border-color 0.2s var(--ease-out);
}

.search-input-wrap:focus-within {
  border-color: #2F5746;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--text-tertiary);
  border-radius: 50%;
  margin-right: 12rpx;
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: "";
  position: absolute;
  top: 22rpx;
  left: 18rpx;
  width: 10rpx;
  height: 4rpx;
  background: var(--text-tertiary);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  height: 80rpx;
}

.search-clear {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.search-clear:active {
  transform: scale(0.9);
}

.search-btn {
  background: #2F5746;
  color: var(--bg-card);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(47, 87, 70, 0.3);
  transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out);
}

.search-btn:active {
  transform: scale(0.95) translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(47, 87, 70, 0.2);
}

/* 搜索中 */
.searching {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* 无结果 */
.no-result {
  text-align: center;
  padding: 100rpx 0;
}

.no-result-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.no-result-text {
  font-size: 30rpx;
  color: var(--text-tertiary);
}

/* 结果列表 */
.result-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.result-item {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(88, 70, 42, 0.04);
  transition: transform 0.15s var(--ease-out);
}

.result-item:active {
  transform: scale(0.98);
}

.result-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-word {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.result-phonetic {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.result-play {
  font-size: 28rpx;
  margin-left: auto;
  padding: 8rpx 14rpx;
  background: #E9F0EB;
  color: #2F5746;
  border-radius: 20rpx;
  font-weight: 600;
  transition: transform 0.15s var(--ease-out);
}

.result-play:active {
  transform: scale(0.9);
}

.result-meaning {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  line-height: 1.5;
}

.result-example {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  line-height: 1.5;
  font-style: italic;
}

/* ECDICT 扩展字段 */
.result-extra {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border-light);
}

.extra-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.extra-key {
  color: var(--text-tertiary);
  background: var(--border-light);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
  font-size: 20rpx;
}

.extra-val {
  color: var(--text-secondary);
  flex: 1;
  word-break: break-all;
}

.result-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.result-tag {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.result-tag.learned-true {
  background: #E5F1E9;
  color: #2E7D32;
}

.result-tag.learned-false {
  background: var(--border-light);
  color: var(--text-tertiary);
}

.result-book {
  font-size: 22rpx;
  background: #E9F0EB;
  color: #2F5746;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

/* 初始提示 */
.hint {
  text-align: center;
  padding-top: 160rpx;
}

.hint-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 30rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E9F0EB, #D4E5F7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hint-icon-book {
  width: 48rpx;
  height: 40rpx;
  border: 4rpx solid #2F5746;
  border-radius: 4rpx;
  position: relative;
}

.hint-icon-book::after {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 16rpx;
  background: #2F5746;
}

.hint-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.hint-sub {
  font-size: 26rpx;
  color: var(--text-quaternary);
  margin-top: 12rpx;
}
