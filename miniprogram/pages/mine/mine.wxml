<!-- pages/mine/mine.wxml -->
<view class="container">
  <!-- 用户头部 -->
  <view class="user-header">
    <view class="user-header-bg"></view>
    <view class="user-header-content">
      <view class="avatar" bindtap="onHeaderTap">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-img" />
        <view wx:else class="avatar-placeholder">
          <view class="avatar-placeholder-icon"></view>
        </view>
      </view>
      <view class="user-info" bindtap="onHeaderTap">
        <view class="nickname">{{nickname}}</view>
        <view class="sub-text" wx:if="{{hasProfile}}">坚持学习，遇见更好的自己</view>
        <view class="sub-text login-link" wx:else>登录后学习数据云端同步，换手机不丢</view>
      </view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-card">
    <view class="stat-block">
      <view class="stat-value">{{stats.learnedToday}}</view>
      <view class="stat-label">今日学习</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value stat-value-accent">{{stats.streakDays}}</view>
      <view class="stat-label">连续天数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value">{{stats.weeklyLearned}}</view>
      <view class="stat-label">本周学习</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-block">
      <view class="stat-value">{{stats.totalWords}}</view>
      <view class="stat-label">累计单词</view>
    </view>
  </view>

  <!-- 打卡按钮 -->
  <view class="checkin-btn {{stats.checkedIn ? 'checked' : ''}}" bindtap="checkIn">
    <view class="checkin-icon" wx:if="{{stats.checkedIn}}"></view>
    {{stats.checkedIn ? '已打卡' : '每日打卡'}}
  </view>

  <!-- 今日复习计划入口 -->
  <view class="plan-entry" bindtap="goPlan">
    <view class="plan-entry-left">
      <view class="plan-entry-title">今日复习计划</view>
      <view class="plan-entry-sub">{{planSummary}}</view>
    </view>
    <view class="plan-entry-arrow">›</view>
  </view>

  <!-- 学习日历热力图 -->
  <view class="heatmap-section">
    <view class="section-header">
      <view class="section-title">学习日历</view>
      <view class="heatmap-sub">近 30 天学了 {{heatmapTotalDays}} 天</view>
    </view>
    <view class="heatmap-grid">
      <view class="heatmap-cell level-{{item.level}}" wx:for="{{heatmap}}" wx:key="date">
        <view class="heatmap-tip">{{item.date}} · {{item.count > 0 ? item.count + '个' : '未学习'}}</view>
      </view>
    </view>
    <view class="heatmap-legend">
      <text class="legend-label">少</text>
      <view class="heatmap-cell level-0 legend-cell"></view>
      <view class="heatmap-cell level-1 legend-cell"></view>
      <view class="heatmap-cell level-2 legend-cell"></view>
      <view class="heatmap-cell level-3 legend-cell"></view>
      <view class="heatmap-cell level-4 legend-cell"></view>
      <text class="legend-label">多</text>
    </view>
  </view>

  <!-- 成就徽章（showAchievements 开关控制，默认关闭） -->
  <view class="badge-section" wx:if="{{showAchievements}}">
    <view class="section-header">
      <view class="section-title">我的成就</view>
      <view class="badge-count">{{badgesUnlocked}}/{{badges.length}}</view>
    </view>
    <view class="badge-grid">
      <view class="badge-item {{badge.unlocked ? '' : 'locked'}}" wx:for="{{badges}}" wx:key="name">
        <view class="badge-icon-wrap">
          <text class="badge-icon">{{badge.icon}}</text>
        </view>
        <view class="badge-name">{{badge.name}}</view>
        <view class="badge-desc">{{badge.desc}}</view>
        <view class="badge-progress-bar">
          <view class="badge-progress-fill {{badge.unlocked ? 'full' : ''}}" style="width: {{(badge.cur || 0) >= (badge.goal || 0) ? 100 : (((badge.cur || 0) / (badge.goal || 1)) * 100)}}%"></view>
        </view>
        <view class="badge-progress-text">{{badge.unlocked ? '已解锁' : (badge.cur || 0) + '/' + (badge.goal || 0)}}</view>
      </view>
    </view>
  </view>

  <!-- 登录/资料编辑弹窗 -->
  <view class="profile-mask" wx:if="{{showProfileEdit}}" bindtap="closeProfileEdit"></view>
  <view class="profile-panel card-taped" wx:if="{{showProfileEdit}}">
    <view class="profile-panel-title">登录 · 完善资料</view>
    <view class="profile-panel-sub">登录后学习数据云端同步，换手机不丢</view>

    <view class="profile-avatar-row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{editAvatar}}" src="{{editAvatar}}" class="profile-avatar" />
        <view wx:else class="profile-avatar profile-avatar-empty">+</view>
      </button>
      <view class="avatar-btn-tip">点击选择微信头像</view>
    </view>

    <view class="profile-nick-row">
      <input
        class="profile-nick-input"
        type="nickname"
        placeholder="请输入昵称（必填）"
        placeholder-class="profile-nick-placeholder"
        value="{{editNickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <button class="btn-primary profile-save" bindtap="onSaveProfile" disabled="{{savingProfile}}">
      {{savingProfile ? '保存中...' : '确认登录'}}
    </button>
    <view class="profile-cancel" bindtap="closeProfileEdit">暂不登录</view>
  </view>

  <!-- 功能入口 -->
  <view class="other-section">
    <view class="section-title section-title-sm">更多</view>
    <view class="other-group">
      <view class="other-item" bindtap="goSearch">
        <view class="other-icon-wrap other-icon-wrap-blue">
          <view class="other-icon-search"></view>
        </view>
        <view class="other-item-text">
          <view class="other-item-name">搜单词</view>
          <view class="other-item-desc">查询释义和词根</view>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="other-item" bindtap="goPoster">
        <view class="other-icon-wrap other-icon-wrap-cyan">
          <view class="other-icon-poster"></view>
        </view>
        <view class="other-item-text">
          <view class="other-item-name">打卡海报</view>
          <view class="other-item-desc">生成你的学习海报</view>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="other-item" bindtap="onExportToday">
        <view class="other-icon-wrap other-icon-wrap-blue">
          <view class="other-icon-search"></view>
        </view>
        <view class="other-item-text">
          <view class="other-item-name">导出今日单词</view>
          <view class="other-item-desc">文本、图片、Excel</view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 隐藏 canvas（导出图片用） -->
    <view class="export-canvas-hidden">
      <canvas type="2d" id="exportCanvas" class="export-canvas"></canvas>
    </view>
  </view>

  <!-- 功能入口 - 设置 -->
  <view class="other-section">
    <view class="section-title section-title-sm">设置</view>
    <view class="other-group">
      <!-- 学习提醒已下线（2026-08-31：一次性订阅需重复授权，体验繁琐；代码保留）
      <view class="other-item" bindtap="onToggleReminder">
        <view class="other-icon-wrap other-icon-wrap-orange">
          <view class="other-icon-reminder"></view>
        </view>
        <view class="other-item-text">
          <view class="other-item-name">学习提醒</view>
          <view class="other-item-desc">次日早上提醒 · 一次授权一条</view>
        </view>
        <text class="reminder-status {{reminderOn ? 'reminder-on' : 'reminder-off'}}">{{reminderOn ? '已开启' : '未开启'}}</text>
      </view>
      -->
      <!-- 每周学习周报已下线（2026-08-31，订阅消息模板体验不佳，代码保留待模板可用后恢复）
      <view class="other-item" bindtap="onToggleWeekly">
        <view class="other-icon-wrap other-icon-wrap-green">
          <view class="other-icon-weekly">周</view>
        </view>
        <view class="other-item-text">
          <view class="other-item-name">每周学习周报</view>
          <view class="other-item-desc">每周日总结本周学习成果</view>
        </view>
        <text class="reminder-status {{weeklyOn ? 'reminder-on' : 'reminder-off'}}">{{weeklyOn ? '已订阅' : '未订阅'}}</text>
      </view>
      -->
      <view class="other-item" bindtap="goPrivacy">
        <view class="other-icon-wrap other-icon-wrap-gray">
          <view class="other-icon-privacy"></view>
        </view>
        <view class="other-item-text">
          <view class="other-item-name">隐私保护声明</view>
          <view class="other-item-desc">查看隐私政策</view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="footer-builder" wx:if="{{builderCount > 0}}">词库共建人 · 已提交 {{builderCount}} 次纠错反馈</view>
  <view class="footer-text">英语补词达人 · 免费学习工具</view>
</view>
